@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Hồ Sơ Bác Sĩ";
    ViewBag.ActiveMenu = "Doctors";
    ViewBag.PageTitle = "Hồ Sơ Bác Sĩ";
    ViewBag.PageSubtitle = "Quản lý thông tin và gán chuyên khoa cho bác sĩ";
}

@section TopbarActions {
    <button class="btn-primary-medical" onclick="openAddDoctorModal()">
          <i class="bi bi-person-plus"></i> Thêm bác sĩ
        </button>
}

<div class="row g-4" id="doctorsGrid">
        <!-- Rendered by JS -->
      </div>
    </div>
  </div>

  <!-- Modal Add/Edit Doctor -->
  <div class="modal fade" id="doctorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content" style="border:none;border-radius:var(--radius-xl);overflow:hidden;">
        <div class="modal-header" style="border-bottom:1px solid var(--bg-tertiary);padding:20px 24px;">
          <h5 class="modal-title" id="doctorModalTitle" style="font-weight:700;">Thêm Bác Sĩ</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body" style="padding:24px;">
          <form id="doctorForm" class="form-medical" novalidate>
            <input type="hidden" id="editDoctorId">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Họ tên bác sĩ</label>
                <input type="text" class="form-control" id="docName" placeholder="VD: Nguyễn Văn An" required>
                <div class="invalid-feedback">Vui lòng nhập tên</div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Học vị</label>
                <select class="form-select" id="docDegree">
                  <option value="BS">BS</option>
                  <option value="BS.CKI">BS.CKI</option>
                  <option value="BS.CKII">BS.CKII</option>
                  <option value="ThS.BS">ThS.BS</option>
                  <option value="TS.BS">TS.BS</option>
                  <option value="PGS.TS">PGS.TS</option>
                  <option value="GS.TS">GS.TS</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Chuyên khoa</label>
                <select class="form-select" id="docSpecialty" required>
                  <option value="">Chọn chuyên khoa</option>
                </select>
                <div class="invalid-feedback">Vui lòng chọn chuyên khoa</div>
              </div>
              <div class="col-md-6">
                <label class="form-label">Giá khám (VNĐ)</label>
                <input type="number" class="form-control" id="docPrice" placeholder="VD: 350000" required min="0">
                <div class="invalid-feedback">Vui lòng nhập giá khám</div>
              </div>
              <div class="col-12">
                <label class="form-label">Giới thiệu ngắn</label>
                <textarea class="form-control" id="docBio" rows="2" placeholder="Kinh nghiệm, thành tích..."></textarea>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer" style="border-top:1px solid var(--bg-tertiary);padding:16px 24px;">
          <button type="button" class="btn-secondary-medical" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn-primary-medical" onclick="saveDoctor()"><i class="bi bi-check-lg"></i> Lưu</button>
        </div>
      </div>
    </div>
  </div>

@section Scripts {
    <script>
    App.requireAuth(['admin']);
    let editingDoctorId = null;

    async function loadDoctors() {
      const grid = document.getElementById('doctorsGrid');
      grid.innerHTML = Array(6).fill('').map(() => `
        <div class="col-md-6 col-xl-4"><div class="skeleton-card"><div class="skeleton-row"><div class="skeleton skeleton-avatar lg"></div><div style="flex:1"><div class="skeleton skeleton-title"></div><div class="skeleton skeleton-text w-75"></div><div class="skeleton skeleton-text w-50"></div></div></div></div></div>
      `).join('');

      const doctors = await API.getDoctors();
      const avatars = ['👨‍⚕️', '👩‍⚕️', '👨‍⚕️', '👩‍⚕️', '👨‍⚕️', '👩‍⚕️'];

      grid.innerHTML = doctors.map((doc, i) => `
        <div class="col-md-6 col-xl-4">
          <div class="card-medical p-4">
            <div class="d-flex align-items-start gap-3 mb-3">
              <div style="width:56px;height:56px;background:linear-gradient(135deg,var(--primary-50),var(--secondary-50));border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;">${avatars[i % avatars.length]}</div>
              <div style="flex:1;min-width:0;">
                <h6 style="margin:0 0 2px;">${doc.degree} ${doc.name}</h6>
                <span class="badge-medical badge-approved" style="font-size:11px;"><span class="status-dot"></span>${doc.specialty}</span>
              </div>
              <div class="d-flex gap-1">
                <button class="btn-icon sm" onclick="openEditDoctorModal('${doc.id}')" aria-label="Sửa"><i class="bi bi-pencil"></i></button>
                <button class="btn-icon sm" onclick="deleteDoctor('${doc.id}','${doc.name}')" aria-label="Xóa" style="color:var(--danger)"><i class="bi bi-trash"></i></button>
              </div>
            </div>
            <p style="font-size:var(--text-sm);color:var(--text-tertiary);margin-bottom:12px;">${doc.bio || 'Chưa có thông tin'}</p>
            <div class="d-flex align-items-center justify-content-between" style="padding-top:12px;border-top:1px solid var(--bg-tertiary);">
              <span style="font-weight:700;color:var(--secondary-600);">${App.formatCurrency(doc.price)}</span>
              <span style="font-size:var(--text-sm);color:var(--warning);font-weight:600;"><i class="bi bi-star-fill"></i> ${doc.rating} (${doc.reviews})</span>
            </div>
          </div>
        </div>
      `).join('');
    }

    async function loadSpecialtyOptions() {
      const specialties = await API.getSpecialties();
      const select = document.getElementById('docSpecialty');
      select.innerHTML = '<option value="">Chọn chuyên khoa</option>';
      specialties.forEach(sp => {
        select.innerHTML += `<option value="${sp.id}" data-name="${sp.name}">${sp.icon} ${sp.name}</option>`;
      });
    }

    function openAddDoctorModal() {
      editingDoctorId = null;
      document.getElementById('doctorModalTitle').textContent = 'Thêm Bác Sĩ';
      document.getElementById('doctorForm').reset();
      new bootstrap.Modal(document.getElementById('doctorModal')).show();
    }

    async function openEditDoctorModal(id) {
      editingDoctorId = id;
      document.getElementById('doctorModalTitle').textContent = 'Sửa Hồ Sơ Bác Sĩ';
      const doc = await API.getDoctorById(id);
      if (!doc) return;
      document.getElementById('docName').value = doc.name;
      document.getElementById('docDegree').value = doc.degree;
      document.getElementById('docSpecialty').value = doc.specialtyId;
      document.getElementById('docPrice').value = doc.price;
      document.getElementById('docBio').value = doc.bio || '';
      new bootstrap.Modal(document.getElementById('doctorModal')).show();
    }

    async function saveDoctor() {
      const form = document.getElementById('doctorForm');
      if (!App.validateForm(form)) return;

      const spSelect = document.getElementById('docSpecialty');
      const spName = spSelect.options[spSelect.selectedIndex].dataset.name;

      const data = {
        name: document.getElementById('docName').value.trim(),
        degree: document.getElementById('docDegree').value,
        specialtyId: spSelect.value,
        specialty: spName,
        price: parseInt(document.getElementById('docPrice').value),
        bio: document.getElementById('docBio').value.trim()
      };

      try {
        if (editingDoctorId) {
          await API.updateDoctor(editingDoctorId, data);
          App.toast.success('Thành công', 'Đã cập nhật hồ sơ bác sĩ');
        } else {
          await API.addDoctor(data);
          App.toast.success('Thành công', 'Đã thêm bác sĩ mới');
        }
        bootstrap.Modal.getInstance(document.getElementById('doctorModal')).hide();
        loadDoctors();
      } catch (err) {
        App.toast.error('Lỗi', err.message);
      }
    }

    function deleteDoctor(id, name) {
      App.confirm('Xóa bác sĩ', `Bạn có chắc muốn xóa hồ sơ "${name}"?<br><small class="text-danger">Lưu ý: Tài khoản đăng nhập của bác sĩ này cũng sẽ bị xóa liên đới.</small>`, async () => {
        try {
          await API.deleteDoctor(id);
          App.toast.success('Đã xóa', `Hồ sơ "${name}" đã được xóa`);
          loadDoctors();
        } catch (err) {
          App.toast.error('Lỗi khi xóa', err.message);
        }
      }, 'Xóa');
    }

    loadSpecialtyOptions();
    loadDoctors();
  </script>
}
