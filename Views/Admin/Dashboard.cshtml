@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
    ViewBag.PageTitle = "Dashboard";
    ViewBag.PageSubtitle = "";
}

@section TopbarActions {
    <span style="font-size:var(--text-sm);color:var(--text-tertiary);" id="currentDate"></span>
        <button class="btn-icon" aria-label="Làm mới" onclick="loadDashboard()"><i class="bi bi-arrow-clockwise"></i></button>
}

<!-- ---- Stat Cards ---- -->
      <div class="row g-4 mb-5">
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card primary">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="stat-icon" style="background:var(--primary-50);color:var(--primary-600)"><i class="bi bi-people-fill"></i></div>
              <span class="stat-change up"><i class="bi bi-arrow-up"></i> 12%</span>
            </div>
            <div class="stat-value" id="statPatients">-</div>
            <div class="stat-label">Tổng bệnh nhân</div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card success">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="stat-icon" style="background:var(--success-light);color:var(--success)"><i class="bi bi-calendar-check-fill"></i></div>
              <span class="stat-change up"><i class="bi bi-arrow-up"></i> 5%</span>
            </div>
            <div class="stat-value" id="statToday">-</div>
            <div class="stat-label">Lịch hẹn hôm nay</div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card warning">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="stat-icon" style="background:var(--warning-light);color:var(--warning)"><i class="bi bi-hourglass-split"></i></div>
            </div>
            <div class="stat-value" id="statPending">-</div>
            <div class="stat-label">Chờ duyệt</div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card info">
            <div class="d-flex align-items-center justify-content-between mb-3">
              <div class="stat-icon" style="background:var(--info-light);color:var(--info)"><i class="bi bi-person-badge-fill"></i></div>
            </div>
            <div class="stat-value" id="statDoctors">-</div>
            <div class="stat-label">Bác sĩ</div>
          </div>
        </div>
      </div>

      <!-- ---- Charts ---- -->
      <div class="row g-4 mb-5">
        <!-- Line Chart -->
        <div class="col-lg-8">
          <div class="card-medical p-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <h5 class="mb-0">Lịch hẹn theo tháng</h5>
              <span class="badge-medical badge-approved"><span class="status-dot"></span> 6 tháng gần nhất</span>
            </div>
            <div style="position: relative; height: 300px; width: 100%;">
              <canvas id="appointmentsChart"></canvas>
            </div>
          </div>
        </div>
        
        <!-- Doughnut Chart -->
        <div class="col-lg-4">
          <div class="card-medical p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <h5 class="mb-0">Phân bổ chuyên khoa</h5>
              <button class="btn-icon" aria-label="Tải báo cáo"><i class="bi bi-download"></i></button>
            </div>
            <div style="position: relative; height: 260px; width: 100%; display: flex; align-items: center; justify-content: center;">
              <canvas id="specialtyChart"></canvas>
            </div>
          </div>
        </div>
      </div>

      <!-- ---- Status Summary & Recent ---- -->
      <div class="row g-4">
        <div class="col-lg-4">
          <div class="card-medical p-4 h-100">
            <h5 class="mb-4">Trạng thái lịch hẹn</h5>
            <div class="d-flex flex-column gap-3">
              <div class="d-flex align-items-center justify-content-between p-3" style="background:var(--warning-light);border-radius:var(--radius-sm);">
                <div class="d-flex align-items-center gap-2">
                  <span style="color:var(--warning);font-size:1.25rem;"><i class="bi bi-hourglass-split"></i></span>
                  <span style="font-weight:600;font-size:var(--text-sm);color:var(--warning-dark);">Chờ duyệt</span>
                </div>
                <span style="font-weight:800;font-size:var(--text-xl);color:var(--warning-dark);" id="statPending2">-</span>
              </div>
              <div class="d-flex align-items-center justify-content-between p-3" style="background:var(--success-light);border-radius:var(--radius-sm);">
                <div class="d-flex align-items-center gap-2">
                  <span style="color:var(--success);font-size:1.25rem;"><i class="bi bi-check-circle-fill"></i></span>
                  <span style="font-weight:600;font-size:var(--text-sm);color:var(--success-dark);">Đã duyệt</span>
                </div>
                <span style="font-weight:800;font-size:var(--text-xl);color:var(--success-dark);" id="statApproved">-</span>
              </div>
              <div class="d-flex align-items-center justify-content-between p-3" style="background:var(--info-light);border-radius:var(--radius-sm);">
                <div class="d-flex align-items-center gap-2">
                  <span style="color:var(--info);font-size:1.25rem;"><i class="bi bi-clipboard-check"></i></span>
                  <span style="font-weight:600;font-size:var(--text-sm);color:var(--info-dark);">Hoàn thành</span>
                </div>
                <span style="font-weight:800;font-size:var(--text-xl);color:var(--info-dark);" id="statCompleted">-</span>
              </div>
              <div class="d-flex align-items-center justify-content-between p-3" style="background:var(--danger-light);border-radius:var(--radius-sm);">
                <div class="d-flex align-items-center gap-2">
                  <span style="color:var(--danger);font-size:1.25rem;"><i class="bi bi-x-circle-fill"></i></span>
                  <span style="font-weight:600;font-size:var(--text-sm);color:var(--danger-dark);">Đã hủy</span>
                </div>
                <span style="font-weight:800;font-size:var(--text-xl);color:var(--danger-dark);" id="statCancelled">-</span>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-8">
          <div class="card-medical p-4">
            <div class="d-flex align-items-center justify-content-between mb-4">
              <h5 class="mb-0">Lịch hẹn gần đây</h5>
              <a href="/Admin/Appointments" class="btn-ghost" style="color:var(--primary-600)">Xem tất cả <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="table-responsive-medical">
              <table class="table-medical">
                <thead>
                  <tr>
                    <th>Bệnh nhân</th>
                    <th>Bác sĩ</th>
                    <th>Ngày</th>
                    <th>Giờ</th>
                    <th>Trạng thái</th>
                  </tr>
                </thead>
                <tbody id="recentAppointments">
                  <!-- Rendered by JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

@section Scripts {
    <script>
    let appointmentsChart = null;
    let specialtyChart = null;

    async function loadDashboard() {
      try {
        const user = App.requireAuth(['admin']);
        if (!user) return;
        
        const userNameEl = document.getElementById('sidebarUserName');
        if (userNameEl) userNameEl.textContent = user.name;
        
        const dateEl = document.getElementById('currentDate');
        if (dateEl) dateEl.textContent = new Date().toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });

        const tbody = document.getElementById('recentAppointments');
        if (tbody) App.showTableLoading(tbody, 5, 4);

        const stats = await API.getDashboardStats();

        // Animate stat cards
        if (document.getElementById('statPatients')) App.animateCounter(document.getElementById('statPatients'), stats.totalPatients);
        if (document.getElementById('statToday')) App.animateCounter(document.getElementById('statToday'), stats.todayAppointments);
        if (document.getElementById('statPending')) App.animateCounter(document.getElementById('statPending'), stats.pending);
        if (document.getElementById('statDoctors')) App.animateCounter(document.getElementById('statDoctors'), stats.totalDoctors);
        
        if (document.getElementById('statPending2')) document.getElementById('statPending2').textContent = stats.pending;
        if (document.getElementById('statApproved')) document.getElementById('statApproved').textContent = stats.approved;
        if (document.getElementById('statCompleted')) document.getElementById('statCompleted').textContent = stats.completed;
        if (document.getElementById('statCancelled')) document.getElementById('statCancelled').textContent = stats.cancelled;

        // ---- Line Chart: Appointments by month ----
        const canvas1 = document.getElementById('appointmentsChart');
        if (canvas1) {
          const ctx1 = canvas1.getContext('2d');
          if (appointmentsChart instanceof Chart) appointmentsChart.destroy();

          const gradient = ctx1.createLinearGradient(0, 0, 0, 300);
          gradient.addColorStop(0, 'rgba(37, 99, 235, 0.15)');
          gradient.addColorStop(1, 'rgba(37, 99, 235, 0.01)');

          appointmentsChart = new Chart(ctx1, {
            type: 'line',
            data: {
              labels: stats.monthlyData.map(m => m.label),
              datasets: [{
                label: 'Lịch hẹn',
                data: stats.monthlyData.map(m => m.appointments),
                borderColor: '#2563EB',
                backgroundColor: gradient,
                borderWidth: 2.5,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#2563EB',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7,
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: {
                  backgroundColor: '#0F172A',
                  titleColor: '#fff',
                  bodyColor: '#fff',
                  cornerRadius: 8,
                  padding: 12,
                  displayColors: false,
                }
              },
              scales: {
                y: {
                  beginAtZero: true,
                  grid: { color: 'rgba(15,23,42,0.05)' },
                  ticks: { font: { size: 12, family: 'Plus Jakarta Sans' }, color: '#94A3B8' }
                },
                x: {
                  grid: { display: false },
                  ticks: { font: { size: 12, family: 'Plus Jakarta Sans' }, color: '#94A3B8' }
                }
              }
            }
          });
        }

        // ---- Doughnut Chart: Specialty distribution ----
        const canvas2 = document.getElementById('specialtyChart');
        if (canvas2) {
          const ctx2 = canvas2.getContext('2d');
          if (specialtyChart instanceof Chart) specialtyChart.destroy();

          const chartColors = ['#2563EB', '#059669', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899'];

          specialtyChart = new Chart(ctx2, {
            type: 'doughnut',
            data: {
              labels: stats.specialtyStats.map(s => s.name),
              datasets: [{
                data: stats.specialtyStats.map(s => s.count),
                backgroundColor: chartColors,
                borderWidth: 0,
                hoverOffset: 8,
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '65%',
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: {
                    padding: 12,
                    usePointStyle: true,
                    pointStyle: 'circle',
                    font: { size: 11, family: 'Plus Jakarta Sans' },
                    color: '#64748B'
                  }
                },
                tooltip: {
                  backgroundColor: '#0F172A',
                  titleColor: '#fff',
                  bodyColor: '#fff',
                  cornerRadius: 8,
                  padding: 12,
                }
              }
            }
          });
        }

        // ---- Recent Appointments Table ----
        if (tbody) {
          const appointments = await API.getAppointments();
          tbody.innerHTML = appointments.slice(0, 5).map(apt => `
            <tr>
              <td>
                <div style="font-weight:600;">${apt.patientName}</div>
                <div style="font-size:var(--text-xs);color:var(--text-tertiary);">${apt.phone}</div>
              </td>
              <td>${apt.doctorName}</td>
              <td>${App.formatDate(apt.date)}</td>
              <td style="font-weight:600;color:var(--primary-600);">${apt.time}</td>
              <td>${App.renderStatusBadge(apt.status)}</td>
            </tr>
          `).join('');
        }
      } catch (err) {
        console.error('Lỗi khi tải Dashboard:', err);
        if (App && App.toast) {
          App.toast.error('Lỗi tải dữ liệu', 'Vui lòng tải lại trang.');
        }
      }
    }

    document.addEventListener('DOMContentLoaded', loadDashboard);
  </script>
}
