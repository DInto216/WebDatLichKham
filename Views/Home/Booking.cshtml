@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Đặt Lịch Khám";
    ViewBag.ActiveNav = "Booking";
}

@section PageStyles {
  <style>
    /* ---- Payment Step Styles ---- */
    .payment-method-card {
      border: 2px solid var(--bg-tertiary);
      border-radius: var(--radius-md);
      padding: 16px 20px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--bg-secondary);
    }
    .payment-method-card:hover {
      border-color: var(--primary-400);
      background: var(--primary-50);
      transform: translateY(-1px);
    }
    .payment-method-card.selected {
      border-color: var(--primary-500);
      background: var(--primary-50);
      box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.15);
    }
    .payment-method-icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }
    .payment-qr-box {
      background: white;
      border-radius: var(--radius-md);
      padding: 24px;
      text-align: center;
      border: 1px solid var(--bg-tertiary);
      animation: fadeIn 0.3s ease;
    }
    .qr-image {
      width: 180px;
      height: 180px;
      border: 4px solid var(--primary-100);
      border-radius: 12px;
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
    }
    .bank-info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px dashed var(--bg-tertiary);
      font-size: var(--text-sm);
    }
    .bank-info-row:last-child { border-bottom: none; }
    .bank-info-row .label { color: var(--text-tertiary); }
    .bank-info-row .value { font-weight: 700; color: var(--text-primary); }
    .copy-btn {
      font-size: 11px;
      padding: 2px 8px;
      border-radius: 4px;
      border: 1px solid var(--primary-300);
      color: var(--primary-600);
      background: transparent;
      cursor: pointer;
      transition: all 0.15s;
    }
    .copy-btn:hover { background: var(--primary-50); }
    .cash-info {
      background: linear-gradient(135deg, var(--primary-50), var(--secondary-50));
      border-radius: var(--radius-md);
      padding: 24px;
      text-align: center;
      animation: fadeIn 0.3s ease;
    }
    .cash-info .cash-icon { font-size: 48px; margin-bottom: 12px; }

    /* Wizard Steps */
    .wizard-steps { display: flex; align-items: center; justify-content: center; gap: 0; }
    .wizard-step { display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; z-index: 2; width: 100px; }
    .step-circle {
      width: 44px; height: 44px; border-radius: 50%;
      background: white; border: 2px solid var(--border-color);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; color: var(--text-tertiary);
      transition: all 0.3s;
    }
    .wizard-step.active .step-circle { border-color: var(--primary-600); background: var(--primary-600); color: white; }
    .wizard-step.completed .step-circle { background: var(--primary-500); border-color: var(--primary-500); color: white; }
    .step-label { font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); text-align: center; }
    .wizard-step.active .step-label { color: var(--text-primary); }

    .wizard-connector { flex: 1; height: 2px; background: var(--border-color); position: relative; top: -12px; z-index: 1; margin: 0 -10px; transition: background 0.3s; }
    .wizard-connector.completed { background: var(--primary-500); }

    /* Doctor Select */
    .doctor-select-card {
      border: 2px solid #e2e8f0; 
      border-radius: 16px; 
      padding: 20px;
      cursor: pointer; 
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
      background: white;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      position: relative;
      overflow: hidden;
    }
    .doctor-select-card:hover { 
      border-color: var(--primary-400); 
      box-shadow: 0 10px 25px rgba(13, 148, 136, 0.2); 
      transform: translateY(-4px); 
      background: #f8fafc;
    }
    .doctor-select-card.selected { 
      border-color: var(--primary-600); 
      background: linear-gradient(135deg, #f0fdfa 0%, #ccfbf1 100%); 
      box-shadow: 0 12px 30px rgba(13, 148, 136, 0.3); 
    }
    .doctor-select-card.selected::before {
      content: '✓';
      position: absolute;
      top: 12px;
      right: 16px;
      width: 24px;
      height: 24px;
      background: var(--primary-600);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: bold;
      box-shadow: 0 2px 8px rgba(13, 148, 136, 0.4);
    }
    
    /* Time Slots */
    .time-slot {
      border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 10px;
      text-align: center; cursor: pointer; transition: all 0.2s; background: white; font-weight: 600; font-size: var(--text-sm);
    }
    .time-slot:hover:not(.disabled) { border-color: var(--primary-300); background: var(--bg-secondary); }
    .time-slot.selected { border-color: var(--primary-600); background: var(--primary-600); color: white; }
    .time-slot.disabled { opacity: 0.4; cursor: not-allowed; background: var(--bg-tertiary); text-decoration: line-through; }
    
    /* Hide green validation tick for empty non-required inputs */
    .was-validated .form-control:valid:placeholder-shown {
        border-color: var(--border-color) !important;
        background-image: none !important;
        box-shadow: none !important;
    }
  </style>
}

<div style="padding-top:100px;padding-bottom:64px;">
    <div class="container">
      <!-- ---- Page Header ---- -->
      <div class="text-center mb-5 animate-fade-in-up">
        <div class="badge-label mx-auto" style="display:inline-flex;"><i class="bi bi-calendar-plus"></i> Đặt lịch khám</div>
        <h2>Đặt Lịch Khám <span class="text-gradient">Trực Tuyến</span></h2>
        <p style="color:var(--text-tertiary);max-width:500px;margin:0 auto;">Chọn chuyên khoa, bác sĩ và khung giờ phù hợp. Không cần đăng nhập.</p>
      </div>

      <!-- ---- Wizard Steps ---- -->
      <div class="booking-wizard" style="max-width:900px;margin:0 auto;">
        <div class="wizard-steps mb-5">
          <div class="wizard-step active" data-step="1"><div class="step-circle">1</div><span class="step-label">Chọn bác sĩ</span></div>
          <div class="wizard-connector"></div>
          <div class="wizard-step" data-step="2"><div class="step-circle">2</div><span class="step-label">Chọn ngày giờ</span></div>
          <div class="wizard-connector"></div>
          <div class="wizard-step" data-step="3"><div class="step-circle">3</div><span class="step-label">Thông tin</span></div>
          <div class="wizard-connector"></div>
          <div class="wizard-step" data-step="4"><div class="step-circle">4</div><span class="step-label">Thanh toán</span></div>
        </div>

        <!-- ============ STEP 1 ============ -->
        <div class="wizard-panel active" id="panel-1">
          <div class="card-medical p-4 p-md-5">
            <h4 class="mb-4"><i class="bi bi-person-badge text-primary-medical me-2"></i>Chọn Chuyên Khoa &amp; Bác Sĩ</h4>
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <div class="form-medical">
                  <label class="form-label">Chuyên khoa</label>
                  <select class="form-select" id="filterSpecialty">
                    <option value="">Tất cả chuyên khoa</option>
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-medical">
                  <label class="form-label">Tìm kiếm bác sĩ</label>
                  <div class="input-icon">
                    <i class="bi bi-search"></i>
                    <input type="text" class="form-control" id="searchDoctor" placeholder="Nhập tên bác sĩ..." onkeyup="BookingWizard.filterDoctors()">
                  </div>
                </div>
              </div>
            </div>
            <div id="doctorList" class="row g-3"></div>
          </div>
        </div>

        <!-- ============ STEP 2 ============ -->
        <div class="wizard-panel" id="panel-2" style="display:none;">
          <div class="card-medical p-4 p-md-5">
            <h4 class="mb-4"><i class="bi bi-calendar-event text-primary-medical me-2"></i>Chọn Ngày &amp; Khung Giờ</h4>
            <div id="selectedDoctorInfo" class="mb-4" style="background:var(--primary-50);border-radius:var(--radius-md);padding:16px;display:flex;align-items:center;gap:16px;"></div>
            <div class="row g-4">
              <div class="col-md-6">
                <div class="form-medical">
                  <label class="form-label">Chọn ngày khám</label>
                  <input type="date" class="form-control" id="bookingDate" required onchange="BookingWizard.onDateChange()">
                  <div class="invalid-feedback">Vui lòng chọn ngày khám</div>
                </div>
              </div>
              <div class="col-md-6">
                <p style="font-size:var(--text-sm);font-weight:600;color:var(--text-secondary);margin-bottom:12px;">Khung giờ trống</p>
                <div id="timeSlots" class="row g-2">
                  <div class="col-12"><p style="color:var(--text-muted);font-size:var(--text-sm);">Vui lòng chọn ngày để xem khung giờ</p></div>
                </div>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-4 pt-4" style="border-top:1px solid var(--bg-tertiary)">
              <button type="button" class="btn-secondary-medical" onclick="BookingWizard.goToStep(1)"><i class="bi bi-arrow-left"></i> Quay lại</button>
              <button type="button" class="btn-primary-medical" id="btnToStep3" disabled onclick="BookingWizard.goToStep(3)">Tiếp tục <i class="bi bi-arrow-right"></i></button>
            </div>
          </div>
        </div>

        <!-- ============ STEP 3 ============ -->
        <div class="wizard-panel" id="panel-3" style="display:none;">
          <div class="row g-4">
            <div class="col-lg-7">
              <div class="card-medical p-4 p-md-5">
                <h4 class="mb-4"><i class="bi bi-person-lines-fill text-primary-medical me-2"></i>Thông Tin Bệnh Nhân</h4>
                <form id="patientForm" class="form-medical mt-2" novalidate oninput="BookingWizard.validateStep3()">
                  <div class="row g-4">
                    <div class="col-md-6">
                      <label class="form-label fw-medium" for="patientName"><i class="bi bi-person text-primary me-2"></i>Họ và tên <span class="text-danger">*</span></label>
                      <input type="text" class="form-control shadow-sm" id="patientName" placeholder="Nhập họ và tên..." style="padding: 12px 15px; border-radius: 8px;" required>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label fw-medium" for="patientPhone"><i class="bi bi-telephone text-primary me-2"></i>Số điện thoại <span class="text-danger">*</span></label>
                      <input type="tel" class="form-control shadow-sm" id="patientPhone" placeholder="Nhập số điện thoại..." style="padding: 12px 15px; border-radius: 8px;" required pattern="[0-9]{10,11}">
                      <div class="invalid-feedback">Số điện thoại phải từ 10-11 số.</div>
                    </div>
                    <div class="col-md-12">
                      <label class="form-label fw-medium" for="patientEmail"><i class="bi bi-envelope text-primary me-2"></i>Email <span class="text-muted fw-normal" style="font-size: 0.9em;">(Để nhận thông báo)</span></label>
                      <input type="email" class="form-control shadow-sm" id="patientEmail" placeholder="Nhập email của bạn..." style="padding: 12px 15px; border-radius: 8px;">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label fw-medium" for="patientGender"><i class="bi bi-gender-ambiguous text-primary me-2"></i>Giới tính</label>
                      <select class="form-select shadow-sm" id="patientGender" style="padding: 12px 15px; border-radius: 8px;">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label fw-medium" for="patientBirthYear"><i class="bi bi-calendar text-primary me-2"></i>Năm sinh <span class="text-danger">*</span></label>
                      <input type="number" class="form-control shadow-sm" id="patientBirthYear" placeholder="Ví dụ: 1990" style="padding: 12px 15px; border-radius: 8px;" min="1900" max="2026" required>
                      <div class="invalid-feedback">Vui lòng nhập năm sinh hợp lệ.</div>
                    </div>
                    <div class="col-12">
                      <label class="form-label fw-medium" for="patientAddress"><i class="bi bi-geo-alt text-primary me-2"></i>Địa chỉ</label>
                      <input type="text" class="form-control shadow-sm" id="patientAddress" placeholder="Nhập địa chỉ của bạn..." style="padding: 12px 15px; border-radius: 8px;">
                    </div>
                    <div class="col-12">
                      <label class="form-label fw-medium" for="patientReason"><i class="bi bi-file-medical text-primary me-2"></i>Lý do khám <span class="text-danger">*</span></label>
                      <textarea class="form-control shadow-sm" id="patientReason" placeholder="Mô tả triệu chứng hoặc lý do bạn muốn khám..." style="padding: 15px; border-radius: 8px; height: 120px" required></textarea>
                    </div>
                  </div>
                </form>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="card-medical p-4 p-md-5" style="position:sticky;top:100px;">
                <h5 class="mb-4"><i class="bi bi-receipt text-primary-medical me-2"></i>Thông Tin Lịch Hẹn</h5>
                <div id="bookingSummary"></div>
                <div class="d-grid gap-2 mt-4 pt-4" style="border-top:1px solid var(--bg-tertiary)">
                  <button type="button" class="btn-primary-medical justify-content-center" style="padding:14px;" id="btnToStep4" onclick="BookingWizard.goToStep(4)">
                    <i class="bi bi-credit-card"></i> Tiếp Tục Thanh Toán
                  </button>
                  <button type="button" class="btn-secondary-medical justify-content-center" onclick="BookingWizard.goToStep(2)">
                    <i class="bi bi-arrow-left"></i> Quay lại
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ============ STEP 4 ============ -->
        <div class="wizard-panel" id="panel-4" style="display:none;">
          <div class="row g-4">
            <div class="col-lg-7">
              <div class="card-medical p-4 p-md-5">
                <h4 class="mb-4"><i class="bi bi-credit-card text-primary-medical me-2"></i>Chọn Phương Thức Thanh Toán</h4>
                <div class="d-flex flex-column gap-3" id="paymentMethods">
                  <!-- Payment methods will be rendered dynamically here -->
                </div>

                <div id="paymentDetails" class="mt-4"></div>

                <div class="d-flex justify-content-between mt-4 pt-4" style="border-top:1px solid var(--bg-tertiary)">
                  <button type="button" class="btn-secondary-medical" onclick="BookingWizard.goToStep(3)">
                    <i class="bi bi-arrow-left"></i> Quay lại
                  </button>
                  <button type="button" class="btn-primary-medical" id="btnConfirm" onclick="BookingWizard.submitBooking()" style="padding:12px 28px;">
                    <i class="bi bi-check-circle"></i> Xác Nhận Đặt Lịch
                  </button>
                </div>
              </div>
            </div>
            <div class="col-lg-5">
              <div class="card-medical p-4 p-md-5" style="position:sticky;top:100px;background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); border: 1px solid #e2e8f0; box-shadow: 0 20px 40px rgba(0,0,0,0.06);">
                <div class="d-flex align-items-center mb-4 pb-3" style="border-bottom: 1px dashed var(--bg-tertiary);">
                  <div style="width: 48px; height: 48px; background: var(--primary-50); color: var(--primary-600); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-right: 16px;">
                    <i class="bi bi-receipt"></i>
                  </div>
                  <h5 class="mb-0 fw-bold" style="color: #1e293b;">Tóm Tắt Đơn Hàng</h5>
                </div>
                
                <div id="paymentSummary" class="mb-4"></div>
                
                <div id="selectedPaymentDisplay" class="p-3 mt-4" style="background: linear-gradient(135deg, var(--primary-50), white); border: 1px solid var(--primary-200); border-radius: 12px; display: none; align-items: center; gap: 12px;">
                  <i class="bi bi-check-circle-fill text-primary fs-3"></i>
                  <div>
                    <div style="font-size: 0.75rem; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; margin-bottom: 2px;">Phương thức thanh toán</div>
                    <div id="selectedPaymentLabel" style="font-weight: 700; color: var(--primary-700); font-size: 1rem;">Thanh toán tại quầy</div>
                  </div>
                </div>
                
                <div class="mt-4 pt-4 text-center">
                  <div class="d-flex align-items-center justify-content-center gap-2 text-muted" style="font-size: 0.8rem; opacity: 0.8;">
                    <i class="bi bi-shield-lock-fill text-success fs-5"></i>
                    <span>Thông tin thanh toán được bảo mật an toàn</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
</div>

@section Scripts {
  <script>
    const BookingWizard = (() => {
      'use strict';

      let currentStep = 1;
      let selectedDoctor = null;
      let selectedDate = null;
      let selectedTime = null;
      let selectedPaymentMethod = 'cash';
      let doctors = [];
      let specialties = [];
      let currentDoctorAppointments = [];

      let paymentSettings = [];
      let PAYMENT_LABELS = {};

      const goToStep = (step) => {
        if (step > currentStep) {
          if (step === 2 && !selectedDoctor) return;
          if (step === 3 && (!selectedDate || !selectedTime)) return;
          if (step === 4) {
            const phone = document.getElementById('patientPhone').value.trim().replace(/\s+/g, '').replace(/-/g, '');
            const phoneRegex = /^\d{10,11}$/;
            const form = document.getElementById('patientForm');
            
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                App.toast.warning('Lưu ý', 'Vui lòng kiểm tra lại các thông tin nhập vào.');
                return;
            }
            if (!phoneRegex.test(phone)) {
                App.toast.warning('Số điện thoại không hợp lệ', 'Số điện thoại phải từ 10 đến 11 chữ số.');
                document.getElementById('patientPhone').focus();
                return;
            }
          }
        }
        currentStep = step;

        document.querySelectorAll('.wizard-step').forEach((el, i) => {
          el.classList.toggle('active', i + 1 === step);
          el.classList.toggle('completed', i + 1 < step);
        });
        document.querySelectorAll('.wizard-connector').forEach((el, i) => {
          el.classList.toggle('completed', i + 1 < step);
        });
        document.querySelectorAll('.wizard-panel').forEach((el, i) => {
          el.style.display = (i + 1 === step) ? 'block' : 'none';
        });

        if (step === 3) updateSummary();
        if (step === 4) updatePaymentSummary();

        window.scrollTo({ top: 200, behavior: 'smooth' });
      };

      const getDoctorPrice = (docId) => {
        const idInt = parseInt(docId.replace(/\D/g, '') || 1);
        return 300000 + ((idInt % 5) * 50000);
      };

      const loadSpecialties = async () => {
        specialties = await API.getSpecialties();
        const select = document.getElementById('filterSpecialty');
        specialties.forEach(sp => {
          const opt = document.createElement('option');
          opt.value = sp.name;
          opt.textContent = `${sp.icon} ${sp.name}`;
          select.appendChild(opt);
        });
        select.addEventListener('change', filterDoctors);
      };

      const loadDoctors = async () => {
        doctors = await API.getDoctors();
        filterDoctors();
      };

      const filterDoctors = () => {
        const list = document.getElementById('doctorList');
        const spFilter = document.getElementById('filterSpecialty').value;
        const search = document.getElementById('searchDoctor').value.toLowerCase();
        
        let filtered = doctors;
        if (spFilter) filtered = filtered.filter(d => d.specialtyName === spFilter);
        if (search) filtered = filtered.filter(d => d.name.toLowerCase().includes(search));

        if (filtered.length === 0) {
            list.innerHTML = '<div class="col-12 text-center py-4 text-muted">Không tìm thấy bác sĩ phù hợp</div>';
            return;
        }

        list.innerHTML = filtered.map(doc => `
          <div class="col-md-6 col-lg-4">
            <div class="doctor-select-card ${selectedDoctor === doc.id ? 'selected' : ''}" onclick="BookingWizard.selectDoctor('${doc.id}')">
              <div class="d-flex gap-3 align-items-center">
                <div class="flex-shrink-0 overflow-hidden shadow-sm" style="width:64px;height:64px;background:var(--bg-secondary);border: 2px solid white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;">
                  ${doc.avatar ? `<img src="${doc.avatar}" style="width:100%;height:100%;object-fit:cover;">` : `👨‍⚕️`}
                </div>
                <div>
                  <div style="font-size:var(--text-xs);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-tertiary);margin-bottom:4px;">${doc.specialtyName}</div>
                  <h6 class="mb-1" style="font-size:15px;color:var(--text-primary);">${doc.academicTitle ? doc.academicTitle + ' ' : ''}${doc.degree ? doc.degree + ' ' : ''}${doc.name}</h6>
                  <div style="font-weight:700;color:var(--primary-600);font-size:15px;margin-top:2px;">${App.formatCurrency(getDoctorPrice(doc.id))}</div>
                </div>
              </div>
            </div>
          </div>
        `).join('');
      };

      const selectDoctor = async (id) => {
        selectedDoctor = id;
        filterDoctors();
        const doc = doctors.find(d => d.id === id);
        
        document.getElementById('selectedDoctorInfo').innerHTML = `
          <div class="overflow-hidden shadow-sm" style="width:48px;height:48px;background:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;">
            ${doc.avatar ? `<img src="${doc.avatar}" style="width:100%;height:100%;object-fit:cover;">` : `👨‍⚕️`}
          </div>
          <div>
            <div class="fw-bold">${doc.academicTitle ? doc.academicTitle + ' ' : ''}${doc.degree ? doc.degree + ' ' : ''}${doc.name}</div>
            <div class="text-tertiary" style="font-size:12px;">${doc.specialtyName}</div>
          </div>
        `;
        
        try {
          currentDoctorAppointments = await API.getAppointments({ doctorId: id });
        } catch(e) {
          currentDoctorAppointments = [];
        }
        
        if (selectedDate) loadTimeSlots();
        goToStep(2);
      };

      const onDateChange = () => {
        selectedDate = document.getElementById('bookingDate').value;
        selectedTime = null;
        document.getElementById('btnToStep3').disabled = true;
        if (selectedDate) loadTimeSlots();
      };

      const loadTimeSlots = () => {
        const container = document.getElementById('timeSlots');
        const timeSlots = ['08:00', '08:30', '09:00', '09:30', '10:00', '10:30', '11:00', '13:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30'];
        
        const bookedTimes = currentDoctorAppointments
          .filter(a => a.date === selectedDate && a.status !== 'cancelled')
          .map(a => a.time);

        container.innerHTML = timeSlots.map(time => {
          const isBooked = bookedTimes.includes(time);
          const disabledClass = isBooked ? 'disabled' : '';
          const selectedClass = time === selectedTime ? 'selected' : '';
          const clickEvent = isBooked ? '' : `onclick="BookingWizard.selectTime('${time}')"`;
          
          return `
            <div class="col-3 col-sm-4 col-md-3">
              <div class="time-slot ${disabledClass} ${selectedClass}" ${clickEvent}>${time}</div>
            </div>
          `;
        }).join('');
      };

      const selectTime = (time) => {
        selectedTime = time;
        loadTimeSlots();
        document.getElementById('btnToStep3').disabled = false;
      };

      const validateStep3 = () => {
        // Validation now handled entirely on Next click
      };

      const updateSummary = () => {
        const doc = doctors.find(d => d.id === selectedDoctor);
        document.getElementById('bookingSummary').innerHTML = `
          <div class="d-flex justify-content-between mb-3"><span class="text-tertiary">Chuyên khoa:</span><span class="fw-bold">${doc.specialtyName}</span></div>
          <div class="d-flex justify-content-between mb-3"><span class="text-tertiary">Bác sĩ:</span><span class="fw-bold">${doc.academicTitle ? doc.academicTitle + ' ' : ''}${doc.degree ? doc.degree + ' ' : ''}${doc.name}</span></div>
          <div class="d-flex justify-content-between mb-3"><span class="text-tertiary">Ngày khám:</span><span class="fw-bold">${App.formatDate(selectedDate)}</span></div>
          <div class="d-flex justify-content-between"><span class="text-tertiary">Khung giờ:</span><span class="fw-bold text-primary">${selectedTime}</span></div>
        `;
      };

      const updatePaymentSummary = () => {
        const doc = doctors.find(d => d.id === selectedDoctor);
        const price = getDoctorPrice(doc.id);
        document.getElementById('paymentSummary').innerHTML = `
          <div class="d-flex justify-content-between mb-3"><span class="text-tertiary">Phí khám:</span><span class="fw-bold">${App.formatCurrency(price)}</span></div>
          <div class="d-flex justify-content-between mb-3"><span class="text-tertiary">Khuyến mãi:</span><span class="fw-bold text-success">- 0 đ</span></div>
          <hr class="my-3 border-dashed">
          <div class="d-flex justify-content-between"><span class="fw-bold">Tổng thanh toán:</span><span class="fw-bold text-danger fs-5">${App.formatCurrency(price)}</span></div>
        `;
        selectPayment(selectedPaymentMethod);
      };

      const selectPayment = (method) => {
        selectedPaymentMethod = method;
        document.querySelectorAll('.payment-method-card').forEach(el => el.classList.remove('selected'));
        document.querySelectorAll('.payment-method-card i').forEach(el => el.style.opacity = '0');
        
        const card = document.getElementById(`pm-${method}`);
        if(card) {
            card.classList.add('selected');
            document.getElementById(`check-${method}`).style.opacity = '1';
        }

        const details = document.getElementById('paymentDetails');
        const setting = paymentSettings.find(s => s.methodCode === method);
        let additionalConfig = {};
        try {
            if (setting && setting.additionalConfigJson) {
                additionalConfig = JSON.parse(setting.additionalConfigJson);
            }
        } catch (e) {}

        if (method === 'cash') {
          details.innerHTML = `
            <div class="cash-info" style="background:linear-gradient(135deg,var(--primary-50),var(--secondary-50));border:1px dashed var(--primary-300);border-radius:12px;padding:24px;text-align:center;">
              <div class="cash-icon" style="font-size:3rem;margin-bottom:10px;">🏥</div>
              <h6 class="mb-2" style="font-weight:700;color:var(--text-primary);">Thanh toán tại quầy lễ tân</h6>
              <p class="text-muted mb-0" style="font-size:0.9rem;">Vui lòng hoàn tất thanh toán tại quầy thu ngân trước khi vào phòng khám. Bạn có thể thanh toán bằng tiền mặt hoặc quẹt thẻ POS.</p>
            </div>
          `;
        } else if (method === 'bank_transfer') {
          const doc = doctors.find(d => d.id === selectedDoctor);
          const priceStr = App.formatCurrency(getDoctorPrice(doc.id));
          const priceRaw = getDoctorPrice(doc.id);
          const bankName = additionalConfig.bankName || 'Vietcombank';
          const accNumber = additionalConfig.accountNumber || '0123456789';
          const accName = additionalConfig.accountName || 'MEDIBOOKING VN';
          // Find bin code for VietQR based on bankName (Mocking here, but in real life it should be handled via proper bank code)
          const bankCodeMap = { 'Vietcombank': '970436', 'BIDV': '970418', 'Techcombank': '970407', 'MB': '970422', 'Vietinbank': '970415' };
          const bin = bankCodeMap[bankName] || '970436';
          
          details.innerHTML = `
            <div class="payment-qr-box" style="background:white;border:1px solid #e2e8f0;border-radius:12px;padding:24px;text-align:center;box-shadow:0 10px 25px rgba(0,0,0,0.05);">
              <div style="background:linear-gradient(135deg, #1e3a8a, #3b82f6);color:white;padding:12px;border-radius:8px;margin-bottom:20px;font-weight:600;">
                <i class="bi bi-bank2 me-1"></i> Chuyển khoản ${bankName}
              </div>
              <div class="qr-image" style="width:180px;height:180px;border:3px solid #f1f5f9;border-radius:12px;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;background:#fff;">
                <img src="https://api.vietqr.io/image/${bin}-${accNumber}-Z33XqE5.jpg?amount=${priceRaw}&addInfo=Thanh toan MediBooking&accountName=${encodeURIComponent(accName)}" alt="QR Code" style="width:100%;height:100%;object-fit:cover;border-radius:8px;">
              </div>
              <div class="bank-info-box" style="background:#f8fafc;padding:16px;border-radius:8px;text-align:left;">
                <div class="bank-info-row"><span class="label">Ngân hàng:</span><span class="value">${bankName}</span></div>
                <div class="bank-info-row"><span class="label">Số tài khoản:</span><span class="value text-primary fs-6">${accNumber} <button type="button" class="copy-btn" onclick="BookingWizard.copyText('${accNumber}')"><i class="bi bi-files"></i></button></span></div>
                <div class="bank-info-row"><span class="label">Chủ tài khoản:</span><span class="value">${accName}</span></div>
                <div class="bank-info-row"><span class="label">Nội dung:</span><span class="value">THANH TOAN KHAM <button type="button" class="copy-btn" onclick="BookingWizard.copyText('THANH TOAN KHAM')"><i class="bi bi-files"></i></button></span></div>
                <div class="bank-info-row"><span class="label">Số tiền:</span><span class="value text-danger fs-6">${priceStr}</span></div>
              </div>
              <div class="mt-3 text-muted" style="font-size:0.8rem;"><i class="bi bi-info-circle me-1"></i>Hệ thống sẽ tự động xác nhận sau 1-2 phút khi nhận được tiền.</div>
            </div>`;
        } else if (method === 'momo') {
          const doc = doctors.find(d => d.id === selectedDoctor);
          const price = App.formatCurrency(getDoctorPrice(doc.id));
          details.innerHTML = `
            <div class="payment-qr-box" style="background:white;border:1px solid #fce7f3;border-radius:12px;padding:24px;text-align:center;box-shadow:0 10px 25px rgba(219,39,119,0.08);">
              <div style="background:linear-gradient(135deg, #be185d, #db2777);color:white;padding:12px;border-radius:8px;margin-bottom:20px;font-weight:600;">
                Quét mã MoMo
              </div>
              <div class="qr-image" style="width:180px;height:180px;border:3px solid #fbcfe8;border-radius:12px;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;background:#fff;">
                <i class="bi bi-qr-code" style="font-size:6rem;color:#db2777;"></i>
              </div>
              <div class="text-center">
                <p class="mb-1 text-muted">Sử dụng ứng dụng MoMo để quét mã</p>
                <h5 class="text-danger fw-bold mt-2">${price}</h5>
              </div>
            </div>`;
        } else if (method === 'zalopay') {
          const doc = doctors.find(d => d.id === selectedDoctor);
          const price = App.formatCurrency(getDoctorPrice(doc.id));
          details.innerHTML = `
            <div class="payment-qr-box" style="background:white;border:1px solid #e0f2fe;border-radius:12px;padding:24px;text-align:center;box-shadow:0 10px 25px rgba(2,132,199,0.08);">
              <div style="background:linear-gradient(135deg, #0369a1, #0284c7);color:white;padding:12px;border-radius:8px;margin-bottom:20px;font-weight:600;">
                Quét mã ZaloPay
              </div>
              <div class="qr-image" style="width:180px;height:180px;border:3px solid #bae6fd;border-radius:12px;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;background:#fff;">
                <i class="bi bi-qr-code" style="font-size:6rem;color:#0284c7;"></i>
              </div>
              <div class="text-center">
                <p class="mb-1 text-muted">Sử dụng ứng dụng ZaloPay để quét mã</p>
                <h5 class="text-danger fw-bold mt-2">${price}</h5>
              </div>
            </div>`;
        }
        details.style.display = 'block';

        const display = document.getElementById('selectedPaymentDisplay');
        const label = document.getElementById('selectedPaymentLabel');
        display.style.display = 'block';
        label.textContent = PAYMENT_LABELS[method];
      };

      const copyText = (text) => {
        navigator.clipboard.writeText(text);
        App.toast.success('Đã sao chép', text);
      };

      const submitBooking = async () => {
        const btn = document.getElementById('btnConfirm');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

        const doc = doctors.find(d => d.id === selectedDoctor);
        const reqData = {
          patientName: document.getElementById('patientName').value,
          phone: document.getElementById('patientPhone').value,
          email: document.getElementById('patientEmail').value,
          gender: document.getElementById('patientGender').value,
          birthYear: parseInt(document.getElementById('patientBirthYear').value || 0),
          address: document.getElementById('patientAddress').value,
          reason: document.getElementById('patientReason').value,
          doctorId: selectedDoctor,
          doctorName: `${doc.academicTitle ? doc.academicTitle + ' ' : ''}${doc.degree ? doc.degree + ' ' : ''}${doc.name}`.trim(),
          specialty: doc.specialtyName,
          date: selectedDate,
          time: selectedTime,
          paymentMethod: selectedPaymentMethod,
          paymentAmount: getDoctorPrice(doc.id)
        };

        try {
          const res = await API.createAppointment(reqData);
          sessionStorage.setItem('lastBooking', JSON.stringify(res));
          window.location.href = `/Home/BookingSuccess?id=${res.bookingId}`;
        } catch(err) {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-check-circle"></i> Xác Nhận Đặt Lịch';
          App.toast.error('Lỗi', err.message);
        }
      };

      const loadPaymentSettings = async () => {
        try {
            const res = await fetch('/api/payments/settings');
            if (!res.ok) throw new Error();
            const allSettings = await res.json();
            paymentSettings = allSettings.filter(s => s.isActive);
            
            // Generate Labels map
            paymentSettings.forEach(s => {
                PAYMENT_LABELS[s.methodCode] = s.displayName;
            });

            renderPaymentMethods();
        } catch (err) {
            console.error('Failed to load payment settings', err);
        }
      };

      const renderPaymentMethods = () => {
        const container = document.getElementById('paymentMethods');
        container.innerHTML = paymentSettings.map((s, idx) => {
            let iconHtml = `<i class="bi ${s.icon || 'bi-credit-card'}"></i>`;
            let bgClass = '';
            let subtitle = '';

            if (s.methodCode === 'cash') {
                iconHtml = '💵';
                bgClass = 'background:linear-gradient(135deg,#ecfdf5,#d1fae5);';
                subtitle = 'Thanh toán trực tiếp khi đến khám';
            } else if (s.methodCode === 'bank_transfer') {
                iconHtml = '🏦';
                bgClass = 'background:linear-gradient(135deg,#eff6ff,#dbeafe);';
                subtitle = 'Vietcombank / BIDV / Techcombank...';
            } else if (s.methodCode === 'momo') {
                iconHtml = '<img src="https://upload.wikimedia.org/wikipedia/vi/f/fe/MoMo_Logo.png" style="width:28px;height:28px;border-radius:4px;">';
                bgClass = 'background:linear-gradient(135deg,#fce7f3,#fbcfe8);';
                subtitle = 'Quét mã QR MoMo';
            } else if (s.methodCode === 'zalopay') {
                iconHtml = '<img src="https://cdn.haitrieu.com/wp-content/uploads/2022/10/Logo-ZaloPay-Square.png" style="width:28px;height:28px;border-radius:4px;">';
                bgClass = 'background:linear-gradient(135deg,#e0f2fe,#bae6fd);';
                subtitle = 'Thanh toán qua ZaloPay';
            }

            const isChecked = idx === 0 ? 'checked' : '';
            const isSelected = idx === 0 ? 'selected' : '';
            const opacity = idx === 0 ? '1' : '0';

            return `
              <label class="payment-method-card ${isSelected}" id="pm-${s.methodCode}" onclick="BookingWizard.selectPayment('${s.methodCode}')">
                <input type="radio" name="paymentMethod" value="${s.methodCode}" class="d-none" ${isChecked}>
                <div class="payment-method-icon" style="${bgClass}">${iconHtml}</div>
                <div style="flex:1;">
                  <div style="font-weight:700;font-size:var(--text-base);">${s.displayName}</div>
                  <div style="font-size:var(--text-xs);color:var(--text-tertiary);">${subtitle}</div>
                </div>
                <i class="bi bi-check-circle-fill" style="color:var(--primary-500);font-size:1.25rem;opacity:${opacity};" id="check-${s.methodCode}"></i>
              </label>
            `;
        }).join('');

        if (paymentSettings.length > 0) {
            selectedPaymentMethod = paymentSettings[0].methodCode;
            selectPayment(selectedPaymentMethod);
        }
      };

      const init = async () => {
        const dateInput = document.getElementById('bookingDate');
        const today = new Date();
        const nextMonth = new Date();
        nextMonth.setDate(today.getDate() + 30);
        
        dateInput.min = today.toISOString().split('T')[0];
        dateInput.max = nextMonth.toISOString().split('T')[0];

        await Promise.all([loadSpecialties(), loadDoctors(), loadPaymentSettings()]);

        // Tự động chọn bác sĩ hoặc chuyên khoa nếu được điều hướng từ AI Chatbot / Trang chi tiết
        const urlParams = new URLSearchParams(window.location.search);
        const docParam = urlParams.get('doctor') || urlParams.get('doctorId');
        const spParam = urlParams.get('specialty') || urlParams.get('specialtyId');

        if (spParam) {
          const select = document.getElementById('filterSpecialty');
          const matchSp = specialties.find(s => s.id === spParam || s.name.toLowerCase() === spParam.toLowerCase());
          if (matchSp && select) {
            select.value = matchSp.name;
            filterDoctors();
          }
        }

        if (docParam) {
          const targetDoc = doctors.find(d => d.id === docParam);
          if (targetDoc) {
            selectDoctor(targetDoc.id);
          }
        }
      };

      return {
        init, goToStep, selectDoctor, filterDoctors, onDateChange, selectTime, validateStep3, selectPayment, copyText, submitBooking
      };
    })();

    document.addEventListener('DOMContentLoaded', BookingWizard.init);
  </script>
}
