@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Tra Cứu Lịch Hẹn";
    ViewBag.ActiveNav = "Lookup";
    ViewBag.HideFooter = true;
}

@section PageStyles {
<style>
    /* ---- Print Slip Styles ---- */
    .print-slip {
      display: none;
    }

    /* ---- Reschedule Time Slots ---- */
    .reschedule-slot {
      border: 1.5px solid #e2e8f0;
      border-radius: 8px;
      padding: 8px 4px;
      text-align: center;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
      background: #f8fafc;
      transition: all 0.2s ease;
      color: #334155;
    }
    .reschedule-slot:hover {
      border-color: #0284c7;
      background: #f0f9ff;
      color: #0284c7;
      transform: translateY(-1px);
    }
    .reschedule-slot.selected {
      background: linear-gradient(135deg, #0284c7 0%, #0d9488 100%);
      color: #ffffff;
      border-color: #0284c7;
      box-shadow: 0 4px 10px rgba(2, 132, 199, 0.25);
    }

    @@media print {
      @@page { margin: 0; }
      body { margin: 1cm; }
      body * { visibility: hidden !important; }
      .print-slip, .print-slip * { visibility: visible !important; }
      .print-slip {
        display: block !important;
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: white;
        z-index: 99999;
        padding: 40px;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .print-slip .slip-header-print {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 3px solid #1e3a5f;
        padding-bottom: 16px;
        margin-bottom: 24px;
      }
      .print-slip .slip-logo-print {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .print-slip .slip-logo-print .logo-box {
        width: 44px; height: 44px;
        background: #2563eb;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        color: white; font-size: 1.3rem;
      }
      .print-slip .slip-logo-print .logo-name {
        font-size: 1.2rem; font-weight: 800; color: #1e293b;
      }
      .print-slip .slip-logo-print .logo-sub {
        font-size: 0.7rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px;
      }
      .print-slip .slip-booking-id {
        text-align: right;
      }
      .print-slip .slip-booking-id .label {
        font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8;
      }
      .print-slip .slip-booking-id .value {
        font-size: 1.1rem; font-weight: 800; font-family: monospace; color: #1e293b;
      }
      .print-slip .slip-main-title {
        text-align: center;
        margin-bottom: 28px;
      }
      .print-slip .slip-main-title h2 {
        font-size: 1.3rem; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: #1e293b; margin-bottom: 4px;
      }
      .print-slip .slip-main-title p {
        font-size: 0.8rem; color: #64748b;
      }
      .print-slip .info-table-print {
        width: 100%; border-collapse: collapse; margin-bottom: 28px;
      }
      .print-slip .info-table-print td {
        padding: 10px 12px; font-size: 0.9rem; border-bottom: 1px solid #e2e8f0;
      }
      .print-slip .info-table-print td:first-child {
        width: 160px; color: #64748b; font-weight: 600;
      }
      .print-slip .info-table-print td:last-child {
        color: #1e293b; font-weight: 600;
      }
      .print-slip .slip-notice {
        background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;
        padding: 16px; margin-bottom: 28px;
      }
      .print-slip .slip-notice .notice-title {
        font-size: 0.75rem; font-weight: 700; color: #16a34a; text-transform: uppercase; margin-bottom: 6px;
      }
      .print-slip .slip-notice p {
        font-size: 0.85rem; color: #334155; margin: 0; line-height: 1.6;
      }
      .print-slip .slip-sign-area {
        display: flex; justify-content: flex-end; margin-top: 40px;
      }
      .print-slip .slip-sign-box {
        text-align: center; min-width: 200px;
      }
      .print-slip .slip-sign-box .sign-date {
        font-size: 0.8rem; color: #64748b; margin-bottom: 60px;
      }
      .print-slip .slip-sign-box .sign-label {
        font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8;
      }
      .print-slip .slip-footer-print {
        position: fixed; bottom: 40px; left: 40px; right: 40px;
        border-top: 1px solid #e2e8f0; padding-top: 10px;
        font-size: 0.7rem; color: #94a3b8;
        display: flex; justify-content: space-between;
      }
    }
  </style>
}

<section class="lookup-section">
      <div class="lookup-card animate-fade-in-up">
        <div class="text-center mb-5">
          <div style="width:64px;height:64px;background:var(--primary-50);border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:28px;color:var(--primary-600);">
            <i class="bi bi-search"></i>
          </div>
          <h3>Tra Cứu Lịch Hẹn</h3>
          <p style="color:var(--text-tertiary);font-size:var(--text-sm);">Nhập số điện thoại để kiểm tra trạng thái tất cả các lịch hẹn của bạn</p>
        </div>

        <form id="lookupForm" class="form-medical" novalidate>
          <div class="mb-4">
            <label class="form-label" for="lookupPhone">Số điện thoại</label>
            <div class="input-icon">
              <i class="bi bi-telephone"></i>
              <input type="tel" class="form-control" id="lookupPhone" placeholder="VD: 0912345678" required>
              <div class="invalid-feedback">Vui lòng nhập số điện thoại</div>
            </div>
          </div>
          <button type="submit" class="btn-primary-medical w-100 justify-content-center" style="padding:14px;" id="lookupBtn">
            <i class="bi bi-search"></i> Tra Cứu
          </button>
        </form>



        <!-- Lookup Result -->
        <div id="lookupResult" style="display:none;"></div>

        <!-- Not Found -->
        <div id="lookupNotFound" style="display:none;margin-top:24px;">
          <div style="background:var(--danger-light);border-radius:var(--radius-md);padding:20px;text-align:center;">
            <div style="font-size:40px;margin-bottom:8px;">😞</div>
            <h6 style="color:var(--danger-dark);margin-bottom:4px;">Không tìm thấy lịch hẹn</h6>
            <p style="font-size:var(--text-xs);color:var(--danger-dark);opacity:0.8;margin:0;">Vui lòng kiểm tra lại số điện thoại.</p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Element for printing -->
    <div id="printSlip" class="print-slip"></div>

    <!-- Modal Hủy Lịch Khám -->
    <div class="modal fade" id="modalCancelAppointment" tabindex="-1" aria-labelledby="modalCancelTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:18px;overflow:hidden;border:none;box-shadow:0 20px 40px rgba(0,0,0,0.15);">
          <div class="modal-header bg-danger text-white border-0 py-3">
            <h5 class="modal-title fs-6 fw-bold" id="modalCancelTitle">
              <i class="bi bi-exclamation-triangle-fill me-2"></i> Xác Nhận Hủy Lịch Khám
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
          </div>
          <div class="modal-body p-4">
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-3 py-2" style="font-size:13px;border-radius:10px;">
              <i class="bi bi-info-circle-fill text-warning flex-shrink-0 fs-5"></i>
              <div>Sau khi hủy, khung giờ khám này sẽ được trả lại để phục vụ bệnh nhân khác.</div>
            </div>

            <div id="cancelApptInfo" class="p-3 mb-3" style="background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;font-size:13.5px;"></div>

            <div class="mb-3">
              <label for="cancelReasonPreset" class="form-label fw-semibold" style="font-size:13.5px;">Lý do hủy lịch:</label>
              <select class="form-select form-select-sm mb-2" id="cancelReasonPreset" style="border-radius:8px;padding:8px 12px;">
                <option value="Bận việc đột xuất không thể đến">Bận việc đột xuất không thể đến</option>
                <option value="Tình trạng sức khỏe đã thuyên giảm / Khỏi bệnh">Tình trạng sức khỏe đã thuyên giảm / Khỏi bệnh</option>
                <option value="Muốn dời sang cơ sở y tế khác">Muốn dời sang cơ sở y tế khác</option>
                <option value="Đã chọn nhầm bác sĩ hoặc chuyên khoa">Đã chọn nhầm bác sĩ hoặc chuyên khoa</option>
                <option value="other">Lý do khác...</option>
              </select>
              <textarea class="form-control form-control-sm" id="cancelReasonDetail" rows="2" placeholder="Ghi chú thêm lý do chi tiết (nếu có)..." style="border-radius:8px;font-size:13px;"></textarea>
            </div>
          </div>
          <div class="modal-footer bg-light border-0 py-2 px-4">
            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal" style="border-radius:8px;">Đóng</button>
            <button type="button" class="btn btn-danger btn-sm px-4 fw-semibold" id="btnConfirmCancel" onclick="confirmCancelAppointment()" style="border-radius:8px;">
              <i class="bi bi-check-lg me-1"></i> Xác Nhận Hủy
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Đổi Lịch Khám -->
    <div class="modal fade" id="modalRescheduleAppointment" tabindex="-1" aria-labelledby="modalRescheduleTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:18px;overflow:hidden;border:none;box-shadow:0 20px 40px rgba(0,0,0,0.15);">
          <div class="modal-header text-white border-0 py-3" style="background:linear-gradient(135deg, #0284c7 0%, #0d9488 100%);">
            <h5 class="modal-title fs-6 fw-bold" id="modalRescheduleTitle">
              <i class="bi bi-calendar2-range-fill me-2"></i> Đổi Lịch Khám Bệnh
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
          </div>
          <div class="modal-body p-4">
            <div id="rescheduleCurrentInfo" class="p-3 mb-3" style="background:#f0f9ff;border-radius:12px;border:1px solid #bae6fd;font-size:13.5px;"></div>

            <div class="mb-3">
              <label for="rescheduleNewDate" class="form-label fw-semibold" style="font-size:13.5px;">Chọn ngày khám mới:</label>
              <input type="date" class="form-control" id="rescheduleNewDate" style="border-radius:8px;padding:8px 12px;" onchange="onRescheduleDateChange()">
            </div>

            <div>
              <label class="form-label fw-semibold d-flex justify-content-between" style="font-size:13.5px;">
                <span>Chọn khung giờ mới:</span>
                <span id="rescheduleSlotStatus" class="text-muted fw-normal" style="font-size:12px;"></span>
              </label>
              <div id="rescheduleSlotsContainer" class="row g-2" style="max-height:180px;overflow-y:auto;">
                <div class="col-12 text-center py-3 text-muted" style="font-size:13px;">
                  Vui lòng chọn ngày khám ở trên để xem khung giờ còn trống
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer bg-light border-0 py-2 px-4">
            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal" style="border-radius:8px;">Hủy bỏ</button>
            <button type="button" class="btn btn-primary btn-sm px-4 fw-semibold" id="btnConfirmReschedule" onclick="confirmRescheduleAppointment()" style="border-radius:8px;background:linear-gradient(135deg,#0284c7,#0d9488);border:none;" disabled>
              <i class="bi bi-calendar-check me-1"></i> Lưu Lịch Khám Mới
            </button>
          </div>
        </div>
      </div>
    </div>

@section Scripts {
<script>
    (() => {
      'use strict';

      const form = document.getElementById('lookupForm');
      const resultDiv = document.getElementById('lookupResult');
      const notFoundDiv = document.getElementById('lookupNotFound');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!App.validateForm(form)) return;

        const phone = document.getElementById('lookupPhone').value.trim();

        const btn = document.getElementById('lookupBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="animate-spin" style="display:inline-block"><i class="bi bi-arrow-repeat"></i></span> Đang tra cứu...';

        resultDiv.style.display = 'none';
        notFoundDiv.style.display = 'none';

        try {
          const results = await API.lookupAppointment(phone);

          if (!results || results.length === 0) {
            notFoundDiv.style.display = 'block';
            notFoundDiv.classList.add('animate-fade-in-up');
          } else {
            const statusMessages = {
              pending: 'Lịch hẹn đang chờ phòng khám xác nhận. Vui lòng chờ.',
              approved: 'Lịch hẹn đã được duyệt. Vui lòng đến đúng giờ!',
              cancelled: 'Lịch hẹn đã bị hủy. Liên hệ hotline để biết thêm chi tiết.',
              completed: 'Ca khám đã hoàn thành. Cảm ơn bạn đã sử dụng dịch vụ!'
            };

            window._lookupResults = results; // Lưu kết quả

            resultDiv.style.display = 'block';
            resultDiv.innerHTML = `<h5 class="mb-4 text-center">Tìm thấy <strong>${results.length}</strong> lịch hẹn của bạn</h5>` + results.map(result => `
              <div class="lookup-result mb-4" style="background:#fff; padding:20px; border-radius:var(--radius-lg); box-shadow:var(--shadow-md); border:1px solid var(--border-color);">
                <div style="text-align:center;margin-bottom:20px;">
                  ${App.renderStatusBadge(result.status)}
                  <p style="font-size:var(--text-xs);color:var(--text-tertiary);margin-top:8px;">${statusMessages[result.status]}</p>
                </div>

                <div style="background:var(--bg-tertiary);border-radius:var(--radius-md);padding:16px;">
                  <div class="d-flex justify-content-between mb-2" style="font-size:var(--text-sm);">
                    <span style="color:var(--text-tertiary);">Mã đặt lịch</span>
                    <span style="font-weight:700;color:var(--primary-600);font-family:var(--font-mono);">${result.bookingId}</span>
                  </div>
                  <div class="d-flex justify-content-between mb-2" style="font-size:var(--text-sm);">
                    <span style="color:var(--text-tertiary);">Bệnh nhân</span>
                    <span style="font-weight:600;">${result.patientName}</span>
                  </div>
                  <div class="d-flex justify-content-between mb-2" style="font-size:var(--text-sm);">
                    <span style="color:var(--text-tertiary);">SĐT</span>
                    <span style="font-weight:600;">${result.phone}</span>
                  </div>
                  <div class="d-flex justify-content-between mb-2" style="font-size:var(--text-sm);">
                    <span style="color:var(--text-tertiary);">Bác sĩ</span>
                    <span style="font-weight:600;">${result.doctorName}</span>
                  </div>
                  <div class="d-flex justify-content-between mb-2" style="font-size:var(--text-sm);">
                    <span style="color:var(--text-tertiary);">Chuyên khoa</span>
                    <span style="font-weight:600;">${result.specialty}</span>
                  </div>
                  <div class="d-flex justify-content-between mb-2" style="font-size:var(--text-sm);">
                    <span style="color:var(--text-tertiary);">Ngày khám</span>
                    <span style="font-weight:600;">${App.formatDate(result.date)}</span>
                  </div>
                  <div class="d-flex justify-content-between" style="font-size:var(--text-sm);">
                    <span style="color:var(--text-tertiary);">Giờ khám</span>
                    <span style="font-weight:700;color:var(--primary-600);">${result.time}</span>
                  </div>
                </div>

                ${(result.status === 'pending' || result.status === 'approved') ? `
                <div class="row g-2 mt-3 pt-3 border-top">
                  <div class="col-6">
                    <button type="button" onclick="openRescheduleModal('${result.bookingId}')" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-1 py-2 fw-semibold" style="font-size:13px;border-radius:10px;">
                      <i class="bi bi-calendar2-range"></i> Đổi lịch
                    </button>
                  </div>
                  <div class="col-6">
                    <button type="button" onclick="openCancelModal('${result.bookingId}')" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-1 py-2 fw-semibold" style="font-size:13px;border-radius:10px;">
                      <i class="bi bi-x-circle"></i> Hủy lịch
                    </button>
                  </div>
                </div>
                ` : ''}

                ${result.status === 'approved' ? `
                <div style="margin-top:12px;">
                  <button onclick="printAppointmentSlip('${result.bookingId}')" class="btn-primary-medical w-100 justify-content-center" style="padding:12px;background:linear-gradient(135deg,#6366f1 0%,#7c3aed 100%);border:none;cursor:pointer;">
                    <i class="bi bi-printer"></i> In phiếu khám
                  </button>
                </div>
                ` : ''}

                ${result.status === 'completed' ? `
                <div style="margin-top:12px;">
                  <a href="/Home/ExamResult?bookingId=${result.bookingId}" class="btn-primary-medical w-100 justify-content-center" style="padding:12px;background:linear-gradient(135deg,#10b981 0%,#059669 100%);border:none;text-decoration:none;">
                    <i class="bi bi-file-earmark-medical"></i> Xem đơn thuốc và Bệnh án
                  </a>
                </div>
                ` : ''}
              </div>
            `).join('');
            resultDiv.classList.add('animate-fade-in-up');
          }
        } catch (err) {
          App.toast.error('Lỗi', 'Đã xảy ra lỗi, vui lòng thử lại');
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-search"></i> Tra Cứu';
      });
    })();

    function printAppointmentSlip(bookingId) {
      if (!window._lookupResults) return;
      const r = window._lookupResults.find(x => x.bookingId === bookingId);
      if (!r) return;

      const today = new Date();
      const printDate = today.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
      const examDate = new Date(r.date);
      const formattedExamDate = examDate.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

      document.getElementById('printSlip').innerHTML = `
        <div class="slip-header-print">
          <div class="slip-logo-print">
            <div class="logo-box"><i class="bi bi-heart-pulse-fill"></i></div>
            <div>
              <div class="logo-name">MediBooking</div>
              <div class="logo-sub">Phòng Khám Đa Khoa</div>
            </div>
          </div>
          <div class="slip-booking-id">
            <div class="label">Mã đặt lịch</div>
            <div class="value">${r.bookingId}</div>
          </div>
        </div>

        <div class="slip-main-title">
          <h2>Phiếu Xác Nhận Lịch Hẹn Khám Bệnh</h2>
          <p>Phiếu này xác nhận lịch hẹn của bạn đã được phòng khám duyệt</p>
        </div>

        <table class="info-table-print">
          <!-- Bổ sung fallback cho thông tin rỗng để in phiếu không bị mất layout -->
          <tr><td>Họ và tên</td><td>${r.patientName || 'Chưa cung cấp'}</td></tr>
          <tr><td>Số điện thoại</td><td>${r.phone || 'Chưa cung cấp'}</td></tr>
          <tr><td>Bác sĩ phụ trách</td><td>${r.doctorName || 'Chưa chỉ định'}</td></tr>
          <tr><td>Chuyên khoa</td><td>${r.specialty || 'Chưa phân khoa'}</td></tr>
          <tr><td>Ngày khám</td><td>${formattedExamDate}</td></tr>
          <tr><td>Giờ khám</td><td style="font-size:1.1rem;font-weight:800;color:#2563eb;">${r.time}</td></tr>
          <tr><td>Lý do khám</td><td>${r.reason || 'Không có thông tin'}</td></tr>
        </table>

        <div class="slip-notice">
          <div class="notice-title">📋 Lưu ý quan trọng</div>
          <p>• Vui lòng đến trước giờ hẹn <strong>15 phút</strong> để làm thủ tục.<br>
             • Mang theo CMND/CCCD và thẻ BHYT (nếu có).<br>
             • Mang theo kết quả xét nghiệm cũ (nếu có).<br>
             • Liên hệ hotline <strong>1900-xxxx</strong> nếu cần hủy hoặc đổi lịch.</p>
        </div>

        <div class="slip-sign-area">
          <div class="slip-sign-box">
            <div class="sign-date">Ngày ${today.getDate()} tháng ${today.getMonth() + 1} năm ${today.getFullYear()}</div>
            <div class="sign-label">Xác nhận của phòng khám</div>
          </div>
        </div>

        <div class="slip-footer-print">
          <span>Phiếu được xuất tự động bởi hệ thống MediBooking</span>
          <span>In ngày: ${printDate}</span>
        </div>
      `;

      setTimeout(() => window.print(), 100);
    }

    // ============================================
    // APPOINTMENT CANCEL & RESCHEDULE HANDLERS
    // ============================================
    let activeCancelBooking = null;
    let activeRescheduleBooking = null;
    let selectedRescheduleSlot = null;

    let modalCancelInstance = null;
    let modalRescheduleInstance = null;

    function getModalInstances() {
      if (!modalCancelInstance && document.getElementById('modalCancelAppointment')) {
        modalCancelInstance = new bootstrap.Modal(document.getElementById('modalCancelAppointment'));
      }
      if (!modalRescheduleInstance && document.getElementById('modalRescheduleAppointment')) {
        modalRescheduleInstance = new bootstrap.Modal(document.getElementById('modalRescheduleAppointment'));
      }
    }

    function openCancelModal(bookingId) {
      getModalInstances();
      if (!window._lookupResults) return;
      const appt = window._lookupResults.find(x => x.bookingId === bookingId);
      if (!appt) return;

      activeCancelBooking = appt;

      document.getElementById('cancelApptInfo').innerHTML = `
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Mã lịch hẹn:</span>
          <strong class="text-primary">${appt.bookingId}</strong>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Bệnh nhân:</span>
          <strong>${appt.patientName}</strong>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Bác sĩ:</span>
          <strong>${appt.doctorName}</strong>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted">Ngày & Giờ:</span>
          <strong class="text-danger">${App.formatDate(appt.date)} (${appt.time})</strong>
        </div>
      `;

      document.getElementById('cancelReasonPreset').value = 'Bận việc đột xuất không thể đến';
      document.getElementById('cancelReasonDetail').value = '';

      modalCancelInstance.show();
    }

    async function confirmCancelAppointment() {
      if (!activeCancelBooking) return;

      const preset = document.getElementById('cancelReasonPreset').value;
      const detail = document.getElementById('cancelReasonDetail').value.trim();
      const reason = preset === 'other' ? (detail || 'Lý do cá nhân') : (detail ? `${preset} - ${detail}` : preset);

      const btn = document.getElementById('btnConfirmCancel');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';

      try {
        const res = await API.cancelAppointment({
          bookingId: activeCancelBooking.bookingId,
          phone: activeCancelBooking.phone,
          reason: reason
        });

        App.toast.success('Thành công', res.message || 'Lịch hẹn đã được hủy.');
        modalCancelInstance.hide();

        // Tải lại danh sách lịch hẹn tự động
        document.getElementById('lookupBtn').click();
      } catch (err) {
        App.toast.error('Không thể hủy lịch', err.message || 'Đã có lỗi xảy ra.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Xác Nhận Hủy';
      }
    }

    function openRescheduleModal(bookingId) {
      getModalInstances();
      if (!window._lookupResults) return;
      const appt = window._lookupResults.find(x => x.bookingId === bookingId);
      if (!appt) return;

      activeRescheduleBooking = appt;
      selectedRescheduleSlot = null;

      document.getElementById('rescheduleCurrentInfo').innerHTML = `
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Mã lịch hẹn:</span>
          <strong class="text-primary">${appt.bookingId}</strong>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Bác sĩ phụ trách:</span>
          <strong>${appt.doctorName} (${appt.specialty})</strong>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted">Lịch hiện tại:</span>
          <strong class="text-secondary">${App.formatDate(appt.date)} (${appt.time})</strong>
        </div>
      `;

      const dateInput = document.getElementById('rescheduleNewDate');
      const today = new Date();
      const minDate = new Date();
      minDate.setDate(today.getDate() + 1); // Đổi từ ngày mai
      const maxDate = new Date();
      maxDate.setDate(today.getDate() + 30);

      dateInput.min = minDate.toISOString().split('T')[0];
      dateInput.max = maxDate.toISOString().split('T')[0];
      dateInput.value = '';

      document.getElementById('rescheduleSlotsContainer').innerHTML = `
        <div class="col-12 text-center py-3 text-muted" style="font-size:13px;">
          Vui lòng chọn ngày khám ở trên để xem khung giờ còn trống
        </div>
      `;
      document.getElementById('rescheduleSlotStatus').textContent = '';
      document.getElementById('btnConfirmReschedule').disabled = true;

      modalRescheduleInstance.show();
    }

    async function onRescheduleDateChange() {
      const dateVal = document.getElementById('rescheduleNewDate').value;
      const container = document.getElementById('rescheduleSlotsContainer');
      const statusLabel = document.getElementById('rescheduleSlotStatus');
      const confirmBtn = document.getElementById('btnConfirmReschedule');

      selectedRescheduleSlot = null;
      confirmBtn.disabled = true;

      if (!dateVal || !activeRescheduleBooking) return;

      container.innerHTML = '<div class="col-12 text-center py-3 text-muted"><span class="spinner-border spinner-border-sm me-1"></span> Đang tải giờ trống...</div>';
      statusLabel.textContent = 'Đang kiểm tra...';

      try {
        const slots = await API.getAvailableSlots(activeRescheduleBooking.doctorId, dateVal);

        if (!slots || slots.length === 0) {
          container.innerHTML = '<div class="col-12 text-center py-3 text-danger" style="font-size:13px;">Bác sĩ không có ca khám trống trong ngày này. Vui lòng chọn ngày khác.</div>';
          statusLabel.textContent = '0 giờ trống';
          return;
        }

        statusLabel.textContent = `${slots.length} khung giờ khả dụng`;

        container.innerHTML = slots.map(slot => `
          <div class="col-3">
            <div class="reschedule-slot" onclick="selectRescheduleSlot('${slot}')" id="slot-${slot.replace(':', '')}">
              ${slot}
            </div>
          </div>
        `).join('');
      } catch (err) {
        container.innerHTML = '<div class="col-12 text-center py-3 text-danger" style="font-size:13px;">Lỗi khi tải khung giờ. Vui lòng thử lại.</div>';
        statusLabel.textContent = '';
      }
    }

    function selectRescheduleSlot(time) {
      selectedRescheduleSlot = time;
      document.querySelectorAll('.reschedule-slot').forEach(el => el.classList.remove('selected'));
      const activeEl = document.getElementById(`slot-${time.replace(':', '')}`);
      if (activeEl) activeEl.classList.add('selected');

      document.getElementById('btnConfirmReschedule').disabled = false;
    }

    async function confirmRescheduleAppointment() {
      if (!activeRescheduleBooking || !selectedRescheduleSlot) return;

      const newDate = document.getElementById('rescheduleNewDate').value;
      if (!newDate) {
        App.toast.warning('Lưu ý', 'Vui lòng chọn ngày khám mới.');
        return;
      }

      const btn = document.getElementById('btnConfirmReschedule');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang cập nhật...';

      try {
        const res = await API.rescheduleAppointment({
          bookingId: activeRescheduleBooking.bookingId,
          phone: activeRescheduleBooking.phone,
          newDate: newDate,
          newTime: selectedRescheduleSlot
        });

        App.toast.success('Đổi lịch thành công', res.message || 'Lịch khám mới đã được cập nhật.');
        modalRescheduleInstance.hide();

        // Tải lại danh sách lịch hẹn tự động
        document.getElementById('lookupBtn').click();
      } catch (err) {
        App.toast.error('Không thể đổi lịch', err.message || 'Đã có lỗi xảy ra.');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-calendar-check me-1"></i> Lưu Lịch Khám Mới';
      }
    }
  </script>
}

