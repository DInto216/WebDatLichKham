@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "MediBooking - Đặt Lịch Khám Bệnh Trực Tuyến";
    ViewBag.ActiveNav = "Index";
}

@section PageStyles {
<style>
    @@keyframes pulse-ring {
      0%   { transform: scale(1); opacity: 0.6; }
      100% { transform: scale(1.6); opacity: 0; }
    }
    @@keyframes bounce-arrow {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-4px); }
    }
    @@keyframes spin-in {
      from { transform: rotate(-180deg) scale(0); opacity: 0; }
      to   { transform: rotate(0deg) scale(1); opacity: 1; }
    }
    @@keyframes ripple-click {
      0%   { transform: scale(0); opacity: 0.5; }
      100% { transform: scale(2.5); opacity: 0; }
    }

    .scroll-to-top-btn {
      position: fixed;
      bottom: 30px;
      right: 30px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--gradient-primary);
      color: white;
      border: none;
      box-shadow: 0 4px 15px rgba(13,148,136,0.4);
      font-size: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(24px) scale(0.8);
      transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
      z-index: 1000;
      overflow: hidden;
    }
    /* Hiện nút với hiệu ứng pop */
    .scroll-to-top-btn.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }
    /* Vòng pulse nằm sau nút */
    .scroll-to-top-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: pulse-ring 2s ease-out infinite;
      z-index: -1;
      opacity: 0;
    }
    .scroll-to-top-btn.show::before {
      opacity: 1;
    }
    /* Icon mũi tên tự bounce */
    .scroll-to-top-btn i {
      animation: bounce-arrow 1.6s ease-in-out infinite;
      display: inline-block;
    }
    /* Hover: nảy lên + đổ bóng sâu hơn */
    .scroll-to-top-btn:hover {
      transform: translateY(-6px) scale(1.08);
      box-shadow: 0 12px 30px rgba(13,148,136,0.5);
    }
    .scroll-to-top-btn:hover i {
      animation: none;
      transform: translateY(-3px);
      transition: transform 0.2s ease;
    }
    /* Ripple khi click */
    .scroll-to-top-btn .ripple {
      position: absolute;
      border-radius: 50%;
      background: rgba(255,255,255,0.4);
      pointer-events: none;
      animation: ripple-click 0.6s ease-out forwards;
    }
    /* Active: nhấn xuống */
    .scroll-to-top-btn:active {
      transform: translateY(-2px) scale(0.95);
    }
  </style>
}

<!-- ============ HERO SECTION ============ -->
    <section class="hero-section" id="hero">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <div class="hero-content animate-fade-in-up">
