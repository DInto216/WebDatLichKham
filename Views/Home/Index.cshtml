                  <i class="bi bi-play-circle"></i> Tìm Hiểu Thêm
                </a>
              </div>
              <div class="hero-stats">
                <div class="stat-item">
                  <span class="stat-number" id="heroStatDoctors" data-count="@(ViewBag.TotalDoctors ?? 0)">0+</span>
                  <span class="stat-text">Bác sĩ</span>
