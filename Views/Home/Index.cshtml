                  <i class="bi bi-calendar-check"></i>
                </div>
                <div class="floating-text">
                  <div class="title">Lịch hẹn đã xác nhận</div>
                  <div class="subtitle">Tại MediBooking</div>
                </div>
              </div>
              <div class="hero-floating-card card-2">
                <div class="floating-icon" style="background:var(--primary-50);color:var(--primary-600)">
                  <i class="bi bi-people-fill"></i>
                </div>
                <div class="floating-text">
                  <div class="title">+2,500 lượt khám</div>
                  <div class="subtitle">Trong tháng này</div>
                </div>
              </div>
              <!-- Hero Illustration -->
              <div style="background:linear-gradient(135deg, rgba(37,99,235,0.1), rgba(13,148,136,0.1)); border-radius:var(--radius-2xl); padding:60px; text-align:center; position:relative;">
                <div style="font-size:120px; line-height:1;">🏥</div>
