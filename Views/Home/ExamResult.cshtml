@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Phiếu Kết Quả Khám Bệnh";
    ViewBag.ActiveNav = "Lookup";
}

@section PageStyles {
  <style>
    body { background: #f1f5f9; }

    .page-wrapper {
      max-width: 800px;
      margin: 0 auto;
      padding: 24px 16px 60px;
    }

    /* ---- Back button & actions bar ---- */
    .actions-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: var(--text-sm);
      font-weight: 600;
      padding: 8px 14px;
      border-radius: var(--radius-md);
      transition: background 0.15s;
    }
    .btn-back:hover {
      background: var(--bg-secondary);
      color: var(--primary);
    }


    /* ---- Medical slip ---- */
    .medical-slip {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06), 0 1px 4px rgba(0,0,0,0.04);
      overflow: hidden;
    }

    /* ---- Header ---- */
    .slip-header {
      background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);
      color: white;
      padding: 32px 36px 28px;
      position: relative;
      overflow: hidden;
    }
    .slip-header::after {
      content: '';
      position: absolute;
      bottom: -30px;
      right: -30px;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: rgba(255,255,255,0.06);
    }
    .slip-header-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      position: relative;
      z-index: 1;
    }
    .slip-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .slip-logo-icon {
      width: 48px; height: 48px;
      background: rgba(255,255,255,0.15);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      backdrop-filter: blur(4px);
    }
    .slip-logo-text {
      font-size: 1.3rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .slip-logo-sub {
      font-size: 0.7rem;
      opacity: 0.7;
      text-transform: uppercase;
      letter-spacing: 1px;
    }
    .slip-id {
      text-align: right;
      position: relative;
      z-index: 1;
    }
    .slip-id-label {
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      opacity: 0.7;
    }
    .slip-id-value {
      font-size: 1rem;
      font-weight: 800;
      font-family: monospace;
      letter-spacing: 0.05em;
    }
    .slip-title {
      text-align: center;
      position: relative;
      z-index: 1;
    }
    .slip-title h2 {
      font-size: 1.2rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 2px;
      color: #ffffff;
    }
    .slip-title p {
      font-size: 0.75rem;
      opacity: 0.75;
      color: #ffffff;
    }

    /* ---- Body ---- */
    .slip-body { padding: 32px 36px; }

    /* ---- Info grid ---- */
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 24px;
      border-bottom: 1px dashed #e2e8f0;
    }
    .info-item label {
      display: block;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #94a3b8;
      font-weight: 600;
      margin-bottom: 3px;
    }
    .info-item p {
      font-size: 0.9rem;
      font-weight: 600;
      color: #1e293b;
      margin: 0;
    }

    /* ---- Diagnosis section ---- */
    .section-block {
      margin-bottom: 24px;
    }
    .section-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #2563eb;
      margin-bottom: 10px;
    }
    .section-label i {
      font-size: 1rem;
    }
    .section-content {
      background: #f8fafc;
      border-left: 3px solid #2563eb;
      padding: 14px 18px;
      border-radius: 0 8px 8px 0;
      font-size: 0.9rem;
      color: #334155;
      line-height: 1.6;
    }

    /* ---- Prescription table ---- */
    .rx-table-container {
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 24px;
    }
    .rx-table {
      width: 100%;
      border-collapse: collapse;
    }
    .rx-table thead th {
      background: #f1f5f9;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #64748b;
      font-weight: 700;
      padding: 12px 16px;
      border-bottom: 1.5px solid #e2e8f0;
      text-align: left;
    }
    .rx-table thead th:first-child { width: 40px; text-align: center; }
    .rx-table thead th:nth-child(3) { width: 80px; text-align: center; }
    .rx-table tbody td {
      padding: 12px 16px;
      font-size: 0.88rem;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: top;
    }
    .rx-table tbody td:first-child { text-align: center; color: #94a3b8; font-weight: 600; }
    .rx-table tbody td:nth-child(3) { text-align: center; font-weight: 700; }
    .rx-table .drug-name { font-weight: 600; color: #1e293b; }
    .rx-table .drug-unit { font-size: 0.75rem; color: #94a3b8; }
    .rx-table tbody tr:last-child td { border-bottom: none; }

    /* ---- Notes ---- */
    .notes-box {
      background: linear-gradient(135deg, rgba(16,185,129,0.06) 0%, rgba(59,130,246,0.06) 100%);
      border: 1px solid rgba(16,185,129,0.15);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 24px;
    }
    .notes-box .notes-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: #059669;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .notes-box p {
      font-size: 0.88rem;
      color: #334155;
      margin: 0;
      line-height: 1.6;
    }

    /* ---- Footer ---- */
    .slip-footer {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      padding-top: 20px;
      border-top: 1px dashed #e2e8f0;
      gap: 20px;
    }
    .slip-footer-left {
      font-size: 0.75rem;
      color: #94a3b8;
    }
    .slip-footer-right {
      text-align: center;
      min-width: 180px;
    }
    .slip-footer-right .sign-date {
      font-size: 0.78rem;
      color: #64748b;
      margin-bottom: 40px;
    }
    .slip-footer-right .sign-name {
      font-weight: 700;
      font-size: 0.9rem;
      color: #1e293b;
    }
    .slip-footer-right .sign-label {
      font-size: 0.7rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* ---- Loading / Error ---- */
    .loading-state, .error-state {
      background: white;
      border-radius: 16px;
      padding: 60px 24px;
      text-align: center;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    }
    .error-state i { font-size: 3rem; color: var(--warning); margin-bottom: 12px; }

    /* ---- Print styles ---- */
    @@media print {
      body { background: white !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .actions-bar, .navbar, .print-button-container { display: none !important; }
      .page-wrapper { padding: 0; max-width: 100%; }
      .medical-slip { box-shadow: none; border-radius: 0; }
      .slip-header {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        background: #1e3a5f !important;
        color: white !important;
      }
      .rx-table thead th {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        background: #f1f5f9 !important;
      }
      .section-content {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .notes-box {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }

    .print-button-container {
      display: flex;
      justify-content: center;
      margin-top: 30px;
    }

    @@media (max-width: 576px) {
      .slip-body { padding: 20px; }
      .slip-header { padding: 20px; }
      .info-grid { grid-template-columns: 1fr; }
      .slip-footer { flex-direction: column; align-items: center; }
    }
  </style>
}

<div class="page-wrapper">
    <!-- Actions bar (hidden when printing) -->
    <div class="actions-bar" id="actionsBar">
      <a href="/Home/Lookup" class="btn-back"><i class="bi bi-arrow-left"></i> Quay lại tra cứu</a>
    </div>

    <!-- Content area -->
    <div id="examContent">
      <div class="loading-state" id="loadingState">
        <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Đang tải...</span></div>
        <p class="text-muted">Đang tải kết quả khám bệnh...</p>
      </div>
    </div>

    <!-- Print Button Container below the result sheet -->
    <div class="print-button-container">
      <button class="btn-primary-medical" onclick="window.print()">
        <i class="bi bi-printer"></i> In phiếu khám
      </button>
    </div>
</div>

@section Scripts {
  <script>
    (() => {
      'use strict';

      const urlParams = new URLSearchParams(window.location.search);
      const id = urlParams.get('id') || urlParams.get('bookingId');
      const contentArea = document.getElementById('examContent');

      if (!id) {
        contentArea.innerHTML = `
          <div class="error-state">
            <i class="bi bi-exclamation-triangle"></i>
            <h5>Thiếu thông tin tra cứu</h5>
            <p class="text-muted">Không tìm thấy mã kết quả khám.</p>
            <a href="/Home/Lookup" class="btn-primary-medical mt-3" style="display:inline-flex;"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
          </div>
        `;
        return;
      }

      fetchRecord(id);

      async function fetchRecord(recordId) {
        try {
          // Fake delay for UX
          await new Promise(r => setTimeout(r, 600));

          const record = await API.getExamResult(recordId);

          if (!record) {
            contentArea.innerHTML = `
              <div class="error-state">
                <i class="bi bi-search"></i>
                <h5>Không tìm thấy kết quả</h5>
                <p class="text-muted">Phiếu kết quả khám không tồn tại hoặc đã bị xóa.</p>
                <a href="/Home/Lookup" class="btn-primary-medical mt-3" style="display:inline-flex;"><i class="bi bi-arrow-left me-1"></i> Tra cứu lại</a>
              </div>
            `;
            return;
          }

          renderRecord(record);
        } catch (err) {
          contentArea.innerHTML = `
            <div class="error-state">
              <i class="bi bi-wifi-off"></i>
              <h5>Lỗi kết nối</h5>
              <p class="text-muted">Không thể tải dữ liệu từ máy chủ. Vui lòng thử lại sau.</p>
              <button onclick="window.location.reload()" class="btn-primary-medical mt-3"><i class="bi bi-arrow-clockwise me-1"></i> Thử lại</button>
            </div>
          `;
        }
      }

      function renderRecord(record) {
        const visitDate = new Date(record.visitDate);
        const formattedDate = visitDate.toLocaleDateString('vi-VN', {
          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
        });

        const items = record.prescriptionItems || [];
        let rxRows = items.map((item, i) => `
          <tr>
            <td>${i + 1}</td>
            <td>
              <div class="drug-name">${item.name}</div>
              <div class="drug-unit">${item.unit || ''}</div>
            </td>
            <td>${item.qty}</td>
            <td>${item.dosage}</td>
          </tr>
        `).join('');

        contentArea.innerHTML = `
          <div class="medical-slip">
            <!-- Header -->
            <div class="slip-header">
              <div class="slip-header-top">
                <div class="slip-logo">
                  <div class="slip-logo-icon"><i class="bi bi-heart-pulse-fill"></i></div>
                  <div>
                    <div class="slip-logo-text">MediBooking</div>
                    <div class="slip-logo-sub">Phòng Khám Đa Khoa</div>
                  </div>
                </div>
                <div class="slip-id">
                  <div class="slip-id-label">Mã bệnh án</div>
                  <div class="slip-id-value">#${record.maBenhAn}</div>
                </div>
              </div>
              <div class="slip-title">
                <h2>Phiếu Kết Quả Khám Bệnh</h2>
                <p>${formattedDate}</p>
              </div>
            </div>

            <!-- Body -->
            <div class="slip-body">

              <!-- Patient info -->
              <div class="info-grid">
                <div class="info-item">
                  <label>Họ và tên bệnh nhân</label>
                  <p>${record.patientName}</p>
                </div>
                <div class="info-item">
                  <label>Số điện thoại</label>
                  <p>${record.soDienThoai}</p>
                </div>
                <div class="info-item">
                  <label>Bác sĩ phụ trách</label>
                  <p>${record.doctorName}</p>
                </div>
                <div class="info-item">
                  <label>Chuyên khoa</label>
                  <p>${record.specialty}</p>
                </div>
              </div>

              <!-- Symptoms -->
              ${record.symptoms ? `
              <div class="section-block">
                <div class="section-label"><i class="bi bi-activity"></i> Triệu chứng lâm sàng</div>
                <div class="section-content">${record.symptoms}</div>
              </div>
              ` : ''}

              <!-- Diagnosis -->
              <div class="section-block">
                <div class="section-label"><i class="bi bi-clipboard2-pulse"></i> Chẩn đoán</div>
                <div class="section-content" style="border-left-color:#dc2626;font-weight:600;">${record.diagnosis}</div>
              </div>

              <!-- Prescription table -->
              ${items.length > 0 ? `
              <div class="section-block">
                <div class="section-label"><i class="bi bi-capsule"></i> Đơn thuốc</div>
                <div class="rx-table-container">
                  <table class="rx-table">
                    <thead>
                      <tr>
                        <th>STT</th>
                        <th>Tên thuốc</th>
                        <th>Số lượng</th>
                        <th>Liều lượng / Cách dùng</th>
                      </tr>
                    </thead>
                    <tbody>
                      ${rxRows}
                    </tbody>
                  </table>
                </div>
              </div>
              ` : ''}

              <!-- Notes -->
              ${record.notes ? `
              <div class="notes-box">
                <div class="notes-title"><i class="bi bi-chat-heart"></i> Lời dặn dò của bác sĩ</div>
                <p>${record.notes}</p>
              </div>
              ` : ''}

              <!-- Footer / Signature -->
              <div class="slip-footer">
                <div class="slip-footer-left">
                  <p style="margin:0;">Mã LS: <strong>#${record.maLichSu}</strong></p>
                  <p style="margin:4px 0 0;">Phiếu được xuất bởi hệ thống MediBooking</p>
                </div>
                <div class="slip-footer-right">
                  <div class="sign-date">Ngày ${visitDate.getDate()} tháng ${visitDate.getMonth() + 1} năm ${visitDate.getFullYear()}</div>
                  <div class="sign-name">${record.doctorName}</div>
                  <div class="sign-label">Bác sĩ điều trị</div>
                </div>
              </div>

            </div>
          </div>
        `;
      }
    })();
  </script>
}
