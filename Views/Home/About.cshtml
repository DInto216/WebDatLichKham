@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Về Chúng Tôi";
    ViewBag.ActiveNav = "About";
}

@section PageStyles {
  <style>
    /* ---- Hero Section ---- */
    .about-hero {
      background: linear-gradient(135deg, rgba(15,23,42,1) 0%, rgba(30,58,138,0.95) 100%);
      color: white;
      padding: 160px 0 120px;
      position: relative;
      overflow: hidden;
    }
    .about-hero::before {
      content: '';
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(56,189,248,0.15) 0%, rgba(56,189,248,0) 70%);
      top: -200px;
      right: -200px;
      border-radius: 50%;
      animation: float 10s infinite alternate;
    }
    .about-hero::after {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(16,185,129,0.1) 0%, rgba(16,185,129,0) 70%);
      bottom: -100px;
      left: -100px;
      border-radius: 50%;
      animation: float 8s infinite alternate-reverse;
    }
    @@keyframes float {
      0% { transform: translateY(0) scale(1); opacity: 0.8; }
      100% { transform: translateY(-30px) scale(1.1); opacity: 1; }
    }
    
    .hero-badge-glow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 20px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 100px;
      backdrop-filter: blur(10px);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--primary-100);
      margin-bottom: 24px;
    }

    /* ---- Dynamic Stats Section ---- */
    .stats-container {
      margin-top: -70px;
      position: relative;
      z-index: 10;
    }
    .stat-glow-card {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.6);
      border-radius: 16px;
      padding: 24px 16px;
      text-align: center;
      box-shadow: 0 15px 35px rgba(0,0,0,0.05);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      height: 100%;
    }
    .stat-glow-card:hover {
      transform: translateY(-12px);
      box-shadow: 0 25px 50px rgba(13,148,136,0.15);
      border-color: rgba(13,148,136,0.3);
    }
    .stat-glow-card h3 {
      font-size: 2.8rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--primary-600), #2dd4bf);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 12px;
      line-height: 1;
    }
    .stat-glow-card p {
      font-weight: 700;
      color: var(--text-secondary);
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: var(--text-sm);
    }
    .icon-wrapper-modern {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      margin: 0 auto 16px;
    }

    /* ---- Journey Timeline ---- */
    .journey-section {
      padding: 120px 0;
      background: #f8fafc;
      overflow: hidden;
    }
    .timeline-modern {
      position: relative;
      max-width: 900px;
      margin: 0 auto;
    }
    .timeline-modern::before {
      content: '';
      position: absolute;
      width: 2px;
      background: linear-gradient(to bottom, transparent, var(--primary-400), var(--primary-400), transparent);
      top: 0;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
    }
    .timeline-node {
      position: relative;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 80px;
      width: 100%;
    }
    .timeline-node:nth-child(even) {
      flex-direction: row-reverse;
    }
    .timeline-dot {
      width: 24px;
      height: 24px;
      background: white;
      border: 4px solid var(--primary-500);
      border-radius: 50%;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      box-shadow: 0 0 0 6px rgba(13,148,136,0.1);
      transition: all 0.3s;
    }
    .timeline-node:hover .timeline-dot {
      transform: translateX(-50%) scale(1.3);
      box-shadow: 0 0 0 8px rgba(13,148,136,0.2);
    }
    .timeline-content-card {
      width: 45%;
      background: white;
      padding: 40px;
      border-radius: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.03);
      position: relative;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid transparent;
    }
    .timeline-content-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(13,148,136,0.08);
      border-color: var(--primary-200);
    }
    .timeline-year {
      font-size: 4rem;
      font-weight: 900;
      color: rgba(13,148,136,0.65);
      position: absolute;
      top: -20px;
      right: 20px;
      z-index: 0;
      line-height: 1;
    }
    .timeline-node:nth-child(even) .timeline-year {
      right: auto;
      left: 20px;
    }
    .timeline-content-card h4 {
      position: relative;
      z-index: 1;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 16px;
      font-size: 1.25rem;
    }
    .timeline-content-card p {
      position: relative;
      z-index: 1;
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.7;
      margin: 0;
    }
    @@media (max-width: 768px) {
      .timeline-modern::before { left: 24px; }
      .timeline-node { flex-direction: row !important; margin-bottom: 50px; }
      .timeline-dot { left: 24px; transform: none !important; }
      .timeline-node:hover .timeline-dot { transform: scale(1.3) !important; }
      .timeline-content-card { width: calc(100% - 60px); margin-left: auto; padding: 24px; }
    }
    
    /* ---- Expert Team ---- */
    .doctor-glow-card {
      background: white;
      border: 2px solid transparent;
      border-radius: 20px;
      padding: 32px 24px;
      text-align: center;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      height: 100%;
      box-shadow: 0 4px 15px rgba(0,0,0,0.04);
      overflow: hidden;
      position: relative;
    }
    .doctor-glow-card:hover {
      box-shadow: 0 15px 35px rgba(13, 148, 136, 0.1);
      transform: translateY(-8px);
      border-color: var(--primary-100);
      background: linear-gradient(180deg, #ffffff 0%, #f0fdfa 100%);
    }
    .doctor-avatar-circle {
      width: 96px;
      height: 96px;
      margin: 0 auto 20px;
      background: var(--bg-secondary);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
      flex-shrink: 0;
      border: 4px solid white;
      box-shadow: 0 8px 20px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .doctor-avatar-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .doctor-meta-info h5 {
      font-size: 1.15rem;
      font-weight: 800;
      margin-bottom: 10px;
      color: var(--text-primary);
    }
    .doctor-meta-info .spec-badge {
      display: inline-block;
      padding: 6px 16px;
      background: var(--primary-50);
      color: var(--primary-700);
      border-radius: 100px;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .doctor-meta-info p {
      font-size: var(--text-sm);
      color: var(--text-secondary);
      margin-bottom: 0;
    }
  </style>
}

  <!-- ---- HERO ---- -->
  <section class="about-hero">
    <div class="container text-center" style="position: relative; z-index: 2;">
      <div class="hero-badge-glow animate-fade-in-up">
        <i class="bi bi-stars" style="color:var(--success)"></i> Khởi tạo kỷ nguyên y khoa số
      </div>
      <h1 class="display-3 fw-extrabold mb-4 animate-fade-in-up delay-1 text-white" style="letter-spacing: -1.5px; line-height: 1.2;">
        Hành Trình Kiến Tạo<br/>
        <span style="background: linear-gradient(135deg, #38bdf8, #34d399); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">MediBooking</span>
      </h1>
      <p class="lead mx-auto mb-0 animate-fade-in-up delay-2" style="max-width: 800px; opacity: 0.9; font-size: 1.25rem; line-height: 1.8;">
        Chúng tôi sinh ra với khát vọng số hóa trải nghiệm y tế, mang đến sự tiện nghi trọn vẹn và an tâm tối đa cho từng bệnh nhân trên hành trình chăm sóc sức khỏe.
      </p>
    </div>
  </section>

  <!-- ---- DYNAMIC STATS ---- -->
  <section class="stats-container container">
    <div class="row g-4 justify-content-center">
      <div class="col-md-4 reveal delay-1">
        <div class="stat-glow-card">
          <div class="icon-wrapper-modern" style="background:#eff6ff;color:#3b82f6;"><i class="bi bi-people-fill"></i></div>
          <h3 class="stat-counter" data-count="@(ViewBag.TotalPatients ?? 0)">0</h3>
          <p>Bệnh nhân tin tưởng</p>
        </div>
      </div>
      <div class="col-md-4 reveal delay-2">
        <div class="stat-glow-card">
          <div class="icon-wrapper-modern" style="background:#f0fdf4;color:#10b981;"><i class="bi bi-shield-plus"></i></div>
          <h3 class="stat-counter" data-count="@(ViewBag.TotalDoctors ?? 0)">0</h3>
          <p>Bác sĩ chuyên khoa</p>
        </div>
      </div>
      <div class="col-md-4 reveal delay-3">
        <div class="stat-glow-card">
          <div class="icon-wrapper-modern" style="background:#faf5ff;color:#a855f7;"><i class="bi bi-diagram-3-fill"></i></div>
          <h3 class="stat-counter" data-count="@(ViewBag.TotalSpecialties ?? 0)">0</h3>
          <p>Chuyên khoa điều trị</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- STORY & TIMELINE ---- -->
  <section class="journey-section">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="badge-label mx-auto mb-3"><i class="bi bi-compass"></i> Cột mốc phát triển</div>
        <h2 class="display-5 fw-extrabold text-dark mb-3" style="letter-spacing:-1px;">Hành Trình Số Hóa</h2>
        <p class="text-secondary mx-auto" style="max-width: 600px; font-size: 1.1rem;">Từng bước thay đổi thói quen khám bệnh, tối ưu trải nghiệm và xây dựng một nền tảng y tế vững mạnh.</p>
      </div>

      <div class="timeline-modern">
        <div class="timeline-node reveal delay-1">
          <div class="timeline-dot"></div>
          <div class="timeline-content-card">
            <div class="timeline-year">01</div>
            <h4>💡 Ý tưởng & Sứ mệnh ban đầu</h4>
            <p>Nhận thấy những khó khăn của bệnh nhân trong quy trình đăng ký khám tại phòng khám, MediBooking được lên ý tưởng như một công cụ tối ưu hóa lịch hẹn trực tuyến nhanh chóng, tinh gọn quy trình thủ tục giấy tờ phức tạp.</p>
          </div>
        </div>

        <div class="timeline-node reveal delay-2">
          <div class="timeline-dot"></div>
          <div class="timeline-content-card">
            <div class="timeline-year">02</div>
            <h4>⚙️ Số hóa Bệnh án & Kê đơn</h4>
            <p>Hệ thống nâng cấp quy trình khám bệnh hoàn toàn số. Bác sĩ trực tiếp lập chẩn đoán lâm sàng, kiểm tra kho thuốc thực tế và kê đơn điện tử hoàn tất ngay trên màn hình.</p>
          </div>
        </div>

        <div class="timeline-node reveal delay-3">
          <div class="timeline-dot"></div>
          <div class="timeline-content-card">
            <div class="timeline-year">03</div>
            <h4>🔒 Ký số & Bảo mật thông tin</h4>
            <p>Tích hợp hệ thống mã hóa bảo mật toàn diện giúp bệnh nhân kiểm tra kết quả khám, đơn thuốc và in trực tiếp bản cứng phiếu kết quả thông qua mã Booking ID cá nhân một cách an toàn nhất.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- EXPERT TEAM (DYNAMIC DOCTORS) ---- -->
  <section style="padding: 120px 0; background: white;">
    <div class="container">
      <div class="text-center mb-5 reveal">
        <div class="badge-label mx-auto mb-3"><i class="bi bi-heart-pulse"></i> Chuyên gia y tế</div>
        <h2 class="display-5 fw-extrabold text-dark mb-3" style="letter-spacing:-1px;">Đội Ngũ Bác Sĩ Của Chúng Tôi</h2>
        <p class="text-secondary mx-auto" style="max-width: 600px; font-size: 1.1rem;">Các bác sĩ đầu ngành giàu kinh nghiệm trực tiếp thăm khám và kê đơn bảo mật tại MediBooking.</p>
      </div>

      <div class="row g-4" id="doctorsContainer">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>
  </section>

@section Scripts {
  <script>
    // Counter Animation Logic
    const animateCounters = () => {
      const counters = document.querySelectorAll('.stat-counter');
      counters.forEach(counter => {
        const target = +counter.getAttribute('data-count');
        const duration = 2000; // 2 seconds
        const increment = target / (duration / 16); // 60fps
        let current = 0;

        const updateCounter = () => {
          current += increment;
          if (current < target) {
            counter.innerText = Math.ceil(current);
            requestAnimationFrame(updateCounter);
          } else {
            counter.innerText = target + (target > 5 ? "+" : ""); // Add '+' if it's a big number
          }
        };
        updateCounter();
      });
    };

    // Trigger counters when they become visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounters();
          observer.disconnect(); // Only run once
        }
      });
    }, { threshold: 0.5 });
    
    const statsContainer = document.querySelector('.stats-container');
    if (statsContainer) observer.observe(statsContainer);

    // Load Doctors Data
    async function loadDoctors() {
      const container = document.getElementById('doctorsContainer');
      try {
        const doctors = await API.getDoctors();
        if (!doctors || doctors.length === 0) {
          container.innerHTML = '<div class="col-12 text-center text-muted py-5">Đang cập nhật đội ngũ bác sĩ...</div>';
          return;
        }

        const avatarsFallback = ['👨‍⚕️', '👩‍⚕️', '👨‍⚕️', '👩‍⚕️', '👨‍⚕️', '👩‍⚕️'];

        container.innerHTML = doctors.slice(0, 4).map((doc, i) => `
          <div class="col-md-6 col-lg-3 reveal delay-${i+1}">
            <a href="/Home/DoctorDetail?id=${doc.id}" style="text-decoration:none; color:inherit; display:block;">
              <div class="doctor-glow-card">
                <div class="doctor-avatar-circle">
                  ${doc.avatar ? `<img src="${doc.avatar}" alt="${doc.name}">` : avatarsFallback[i % avatarsFallback.length]}
                </div>
                <div class="doctor-meta-info">
                  <h5>${doc.name}</h5>
                  <span class="spec-badge">${doc.specialtyName}</span>
                  <p class="fw-medium">${doc.degree || 'Bác sĩ chuyên khoa'}</p>
                  <p style="font-size:13px;color:var(--text-muted);margin-top:12px;"><i class="bi bi-clock me-1"></i>${doc.experience || 'Nhiều năm kinh nghiệm'}</p>
                </div>
              </div>
            </a>
          </div>
        `).join('');
        
        if (typeof App !== 'undefined' && typeof App.init === 'function') {
            App.init(); // re-init reveal for dynamically added elements
        }
      } catch (err) {
        container.innerHTML = '<div class="col-12 text-center text-muted py-5">Không thể tải thông tin bác sĩ.</div>';
      }
    }

    loadDoctors();
  </script>
}
