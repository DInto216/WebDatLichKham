@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewBag.Title = "Về Chúng Tôi";
    ViewBag.ActiveNav = "About";
}

@section PageStyles {
  <style>
    /* ==========================================================================
       EXCLUSIVE AESTHETIC STYLE FOR ABOUT US PAGE (Futuristic & Premium)
       ========================================================================== */

    .about-hero-creative {
      background: radial-gradient(circle at 10% 20%, rgba(30,58,138,0.95) 0%, rgba(15,23,42,1) 90%);
      color: white;
      padding: 140px 0 110px;
      position: relative;
      overflow: hidden;
    }
    .about-hero-creative h1 {
      color: #ffffff !important;
    }
    .about-hero-creative::before {
      content: '';
      position: absolute;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(99,102,241,0.2) 0%, rgba(99,102,241,0) 70%);
      top: -100px;
      right: -50px;
      border-radius: 50%;
      animation: pulse-glow 8s infinite alternate;
    }
    .about-hero-creative::after {
      content: '';
      position: absolute;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(16,185,129,0.15) 0%, rgba(16,185,129,0) 70%);
      bottom: -50px;
      left: -50px;
      border-radius: 50%;
      animation: pulse-glow 6s infinite alternate-reverse;
    }
    @@keyframes pulse-glow {
      0% { transform: scale(1); opacity: 0.6; }
      100% { transform: scale(1.2); opacity: 1; }
    }
    .about-hero-content {
      position: relative;
      z-index: 2;
    }
    .hero-badge-glow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 100px;
      backdrop-filter: blur(10px);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--primary-100);
      margin-bottom: 24px;
    }

    /* ---- Abstract Stats Section ---- */
    .stats-container {
      margin-top: -60px;
      position: relative;
      z-index: 10;
    }
    .stat-glass-card {
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.5);
      border-radius: var(--radius-xl);
      padding: 32px 24px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.08);
      transition: all 0.3s ease;
    }
    .stat-glass-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 30px 60px rgba(99,102,241,0.15);
    }
    .stat-glass-card h3 {
      font-size: 3rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--primary-600), var(--primary-400));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 8px;
    }
    .stat-glass-card p {
      font-weight: 600;
      color: var(--text-secondary);
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: var(--text-sm);
    }

    /* ---- Modern Story Section ---- */
    .story-section {
      padding: 100px 0;
      background: white;
    }
    .story-img-wrapper {
      position: relative;
      border-radius: var(--radius-2xl);
      overflow: hidden;
      box-shadow: var(--shadow-2xl);
    }
    .story-img-wrapper img {
      width: 100%;
      height: auto;
      transition: transform 0.7s ease;
    }
    .story-img-wrapper:hover img {
      transform: scale(1.05);
    }
    .story-img-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 40px;
      background: linear-gradient(to top, rgba(15,23,42,0.9) 0%, rgba(15,23,42,0) 100%);
      color: white;
    }

    /* ---- Creative Journey Timeline ---- */
    .journey-section {
      padding: 100px 0;
      background: var(--bg-secondary);
    }
    .journey-timeline-creative {
      position: relative;
      max-width: 800px;
      margin: 0 auto;
    }
    .journey-timeline-creative::before {
      content: '';
      position: absolute;
      width: 2px;
      background: linear-gradient(to bottom, var(--primary-500), var(--success));
      top: 0;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
    }
    .timeline-node {
      position: relative;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 60px;
      width: 100%;
    }
    .timeline-node:nth-child(even) {
      flex-direction: row-reverse;
    }
    .timeline-dot {
      width: 24px;
      height: 24px;
      background: white;
      border: 4px solid var(--primary-500);
      border-radius: 50%;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      box-shadow: 0 0 0 4px rgba(13,148,136,0.2);
    }
    .timeline-content-card {
      width: 45%;
      background: white;
      padding: 32px;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      position: relative;
      transition: all 0.3s;
    }
    .timeline-content-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-xl);
    }
    .timeline-year {
      font-size: 2rem;
      font-weight: 800;
      color: var(--primary-100);
      position: absolute;
      top: -20px;
      right: 20px;
      z-index: 0;
    }
    .timeline-node:nth-child(even) .timeline-year {
      right: auto;
      left: 20px;
    }
    .timeline-content-card h4 {
      position: relative;
      z-index: 1;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 12px;
    }
    .timeline-content-card p {
      position: relative;
      z-index: 1;
      font-size: var(--text-sm);
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
    }

    @@media (max-width: 768px) {
      .journey-timeline-creative::before { left: 24px; }
      .timeline-node { flex-direction: row !important; margin-bottom: 40px; }
      .timeline-dot { left: 24px; transform: none; }
      .timeline-content-card { width: calc(100% - 48px); margin-left: auto; }
    }
  </style>
}

  <!-- ---- HERO ---- -->
  <section class="about-hero-creative">
    <div class="container animate-fade-in-up">
      <div class="hero-badge-glow">
        <i class="bi bi-stars" style="color:var(--success)"></i> Khởi tạo kỷ nguyên y khoa số
      </div>
      <h1 class="display-4 fw-extrabold mb-4" style="letter-spacing: -1px; line-height: 1.2;">Hành Trình <span style="background: linear-gradient(to right, #60a5fa, #34d399); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">MediBooking</span></h1>
      <p class="lead mx-auto mb-0" style="max-width: 720px; opacity: 0.85; font-size: 1.15rem; line-height: 1.7;">
        Chúng tôi sinh ra với khát vọng số hóa trải nghiệm y tế, mang đến sự tiện nghi trọn vẹn và an tâm tối đa cho từng bệnh nhân trên hành trình chăm sóc sức khỏe.
      </p>
    </div>
  </section>

  <!-- ---- VALUE PROPOSITIONS ---- -->
  <section style="margin-top: -50px; position: relative; z-index: 10;">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4">
          <div class="stat-glow-card">
            <div class="icon-wrapper" style="background:#eff6ff;color:#2563eb;"><i class="bi bi-clock-history"></i></div>
            <h5 class="fw-bold text-dark">Tiết Kiệm Thời Gian</h5>
            <p class="text-secondary" style="font-size:var(--text-sm);">Đặt chỗ trước, chuẩn bị hồ sơ y tế từ xa, bỏ qua hoàn toàn quy trình bốc số xếp hàng truyền thống.</p>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="stat-glow-card">
            <div class="icon-wrapper" style="background:#f0fdf4;color:#16a34a;"><i class="bi bi-shield-check"></i></div>
            <h5 class="fw-bold text-dark">Ký Số An Toàn</h5>
            <p class="text-secondary" style="font-size:var(--text-sm);">Thông tin bệnh án được mã hóa và xác nhận bằng chữ ký số của bác sĩ điều trị, đảm bảo tính bảo mật pháp lý.</p>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="stat-glow-card">
            <div class="icon-wrapper" style="background:#faf5ff;color:#9333ea;"><i class="bi bi-graph-up-arrow"></i></div>
            <h5 class="fw-bold text-dark">Tối Ưu Vận Hành</h5>
            <p class="text-secondary" style="font-size:var(--text-sm);">Hỗ trợ bác sĩ sắp xếp lịch trực, kiểm soát thông tin khám và đơn thuốc tối ưu thông qua bảng điều khiển quản trị.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- STORY & TIMELINE ---- -->
  <section style="padding: 100px 0; background: var(--bg-primary);">
    <div class="container">
      <div class="text-center mb-5">
        <div class="badge-label mx-auto mb-3"><i class="bi bi-compass"></i> Cột mốc phát triển</div>
        <h2 class="fw-extrabold text-dark">Hành Trình Kiến Tạo</h2>
      </div>

      <div class="journey-timeline-creative">
        <div class="timeline-node">
          <div class="timeline-dot"></div>
          <div class="timeline-content-card">
            <h4>💡 Ý tưởng &amp; Sứ mệnh ban đầu</h4>
            <p>Nhận thấy những khó khăn của bệnh nhân trong quy trình đăng ký khám tại phòng khám, MediBooking được lên ý tưởng như một công cụ tối ưu hóa lịch hẹn trực tuyến nhanh chóng, tinh gọn quy trình thủ tục giấy tờ phức tạp.</p>
          </div>
        </div>

        <div class="timeline-node">
          <div class="timeline-dot"></div>
          <div class="timeline-content-card">
            <h4>⚙️ Số hóa Bệnh án &amp; Kê đơn</h4>
            <p>Hệ thống nâng cấp quy trình khám bệnh hoàn toàn số. Bác sĩ trực tiếp lập chẩn đoán lâm sàng, kiểm tra kho thuốc thực tế và kê đơn điện tử hoàn tất ngay trên màn hình.</p>
          </div>
        </div>

        <div class="timeline-node">
          <div class="timeline-dot"></div>
          <div class="timeline-content-card">
            <h4>🔒 Ký số &amp; Bảo mật thông tin</h4>
            <p>Tích hợp hệ thống mã hóa bảo mật toàn diện giúp bệnh nhân kiểm tra kết quả khám, đơn thuốc và in trực tiếp bản cứng phiếu kết quả thông qua mã Booking ID cá nhân.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- EXPERT TEAM (DYNAMIC DOCTORS) ---- -->
  <section style="padding: 100px 0; background: white;">
    <div class="container">
      <div class="text-center mb-5">
        <div class="badge-label mx-auto mb-3"><i class="bi bi-people"></i> Chuyên gia y tế</div>
        <h2 class="fw-extrabold text-dark">Đội Ngũ Bác Sĩ Chuyên Khoa</h2>
        <p class="text-secondary" style="max-width: 600px; margin: 0 auto;">Các bác sĩ đầu ngành giàu kinh nghiệm trực tiếp thăm khám và kê đơn bảo mật tại MediBooking.</p>
      </div>

      <div class="row g-4" id="doctorsContainer">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>
  </section>

@section Scripts {
  <script>
    async function loadDoctors() {
      const container = document.getElementById('doctorsContainer');
      try {
        const doctors = await API.getDoctors();
        if (!doctors || doctors.length === 0) {
          container.innerHTML = '<div class="col-12 text-center text-muted">Đang cập nhật đội ngũ bác sĩ...</div>';
          return;
        }

        container.innerHTML = doctors.slice(0, 4).map(doc => `
          <div class="col-sm-6 col-lg-3">
            <div class="doctor-glow-card">
              <div class="doctor-avatar-circle">
                ${doc.name.replace('BS. ', '').charAt(0)}
              </div>
              <div class="doctor-meta-info">
                <h5>${doc.name}</h5>
                <span class="spec-badge">${doc.specialty}</span>
                <p>${doc.degree || 'Bác sĩ chuyên khoa'}</p>
                <p style="font-size:12px;color:var(--text-muted);margin-top:6px;"><i class="bi bi-clock me-1"></i>${doc.experience || 'Nhiều năm kinh nghiệm'}</p>
              </div>
            </div>
          </div>
        `).join('');
      } catch (err) {
        container.innerHTML = '<div class="col-12 text-center text-muted">Không thể tải thông tin bác sĩ.</div>';
      }
    }

    loadDoctors();
  </script>
}



